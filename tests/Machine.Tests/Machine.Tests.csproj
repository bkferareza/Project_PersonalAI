    <ProjectReference Include="..\..\src\Machine.Ollama\Machine.Ollama.csproj" />
    <ProjectReference Include="..\..\src\Machine.Windows\Machine.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="..\..\src\Machine.App\Ambient\CompactPresencePresentation.cs"
      Link="CompactPresencePresentation.cs" />
