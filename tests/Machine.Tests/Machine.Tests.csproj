      Include="..\..\src\Machine.App\Ambient\AmbientOrbFrameSequence.cs"
      Link="AmbientOrbFrameSequence.cs" />
    <Compile
      Include="..\..\src\Machine.App\Ambient\AmbientFullscreenPolicy.cs"
      Link="AmbientFullscreenPolicy.cs" />
