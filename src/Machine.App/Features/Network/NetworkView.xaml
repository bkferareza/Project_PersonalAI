<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Machine.App.Features.NetworkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App.Features"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
<ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12,0,12,16" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Network" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Read-only local interface activity" />
                        </StackPanel>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Current activity" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="RECEIVE" />
                                        <TextBlock
                                            x:Name="NetworkReceiveRateText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="NetworkReceiveRateText"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="Unavailable"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="SEND" />
                                        <TextBlock
                                            x:Name="NetworkSendRateText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="NetworkSendRateText"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="Unavailable"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="ACTIVITY" />
                                        <TextBlock
                                            x:Name="NetworkActivityClassText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="NetworkActivityClassText"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="Unavailable"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Interfaces" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Active local adapters only. No addresses, endpoints, or packet data." />
                                <TextBlock
                                    x:Name="NetworkInterfacesEmptyText" x:FieldModifier="internal"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="No active non-loopback interfaces detected." />
                                <ItemsControl
                                    x:Name="NetworkInterfacesList" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="NetworkInterfacesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:NetworkInterfaceDisplayItem">
                                            <StackPanel Margin="0,5" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind StatusAndType}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind Description}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    Text="{x:Bind LinkDetails}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind ReceivedDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind SentDetails}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="NetworkStatusText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="NetworkStatusText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Loading..." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Session context" />
                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="WINDOWS UPTIME" />
                                        <TextBlock x:Name="SessionSystemUptimeText" x:FieldModifier="internal" Text="Unavailable" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="MATASURI UPTIME" />
                                        <TextBlock x:Name="SessionMachineUptimeText" x:FieldModifier="internal" Text="Unavailable" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="INPUT STATE" />
                                        <TextBlock x:Name="SessionInputStateText" x:FieldModifier="internal" Text="Unavailable" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="IDLE DURATION" />
                                        <TextBlock x:Name="SessionIdleDurationText" x:FieldModifier="internal" Text="Unavailable" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Idle means no user input for at least five minutes. No absence or productivity inference." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
</UserControl>
