<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Machine.App.Features.StartupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App.Features"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
<ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12,0,12,16" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Startup" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Run keys and Startup folders only" />
                        </StackPanel>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Startup applications" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Read-only registrations. Enabled state and startup impact are not inferred." />
                                <TextBox
                                    x:Name="StartupSearchBox" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="StartupSearchBox"
                                    PlaceholderText="Search by name, command, or path" />
                                <TextBlock
                                    x:Name="StartupInventorySummaryText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="StartupInventorySummaryText"
                                    Text="0 entries found&#x0a;Showing 0"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="RefreshStartupButton" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="RefreshStartupButton"
                                    Content="Refresh startup applications"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False" />
                                <ListView
                                    x:Name="StartupApplicationsList" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="StartupApplicationsList"
                                    MaxHeight="430"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:StartupApplicationDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind CommandOrPathDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind SourceDetails}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="StartupInventoryStatusText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="StartupInventoryStatusText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Loading..." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
</UserControl>
