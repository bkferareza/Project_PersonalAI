<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Machine.App.Features.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App.Features"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
<ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16,4,16,20" Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource PageTitleStyle}"
                                    Text="History" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="What happened, while Matasuri was observing" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    x:Name="History24HourButton" x:FieldModifier="internal"
                                    AutomationProperties.Name="Show last 24 hours"
                                    Content="24h"
                                    Tag="24h" />
                                <Button
                                    x:Name="History7DayButton" x:FieldModifier="internal"
                                    AutomationProperties.Name="Show last 7 days"
                                    Content="7d"
                                    Tag="7d" />
                                <Button
                                    x:Name="History30DayButton" x:FieldModifier="internal"
                                    AutomationProperties.Name="Show last 30 days"
                                    Content="30d"
                                    Tag="30d" />
                                <Button
                                    x:Name="HistoryAllButton" x:FieldModifier="internal"
                                    AutomationProperties.Name="Show all retained history"
                                    Content="All"
                                    Tag="all" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Style="{StaticResource MetricLabelStyle}"
                                Text="OBSERVED" />
                            <TextBlock
                                x:Name="HistoryObservedDurationText" x:FieldModifier="internal"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="Beginning now" />
                            <TextBlock
                                x:Name="HistoryResolutionText" x:FieldModifier="internal"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="5-minute rollups · offline time remains a gap" />
                        </StackPanel>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource SectionTitleStyle}"
                                        Text="Resource posture" />
                                <TextBlock
                                    x:Name="HistoryResourceSummaryText" x:FieldModifier="internal"
                                        Grid.Column="1"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Waiting for history" />
                                </Grid>
                                <Canvas
                                    x:Name="HistoryTrendCanvas" x:FieldModifier="internal"
                                    Height="112">
                                    <Path
                                        x:Name="HistoryCpuPolyline" x:FieldModifier="internal"
                                        Stroke="{StaticResource MatasuriStateAccentBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.5" />
                                    <Path
                                        x:Name="HistoryMemoryPolyline" x:FieldModifier="internal"
                                        Opacity="0.5"
                                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.2" />
                                    <Path
                                        x:Name="HistoryGpuPolyline" x:FieldModifier="internal"
                                        Opacity="0.7"
                                        Stroke="#FF9B8562"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.2" />
                                </Canvas>
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Text="CPU" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Memory" />
                                    <TextBlock
                                        x:Name="HistoryGpuLegendText" x:FieldModifier="internal"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="GPU when available" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Estimated power and energy" />
                                <TextBlock x:Name="HistoryPowerSummaryText" x:FieldModifier="internal" Text="Estimated power begins with new observations" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="GPU board power is measured only when the driver reports it. CPU and wall power are estimates; offline and suspend gaps are excluded." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="DailyEnergyCostSection" x:FieldModifier="internal" Spacing="8" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Daily observed energy" />
                            <TextBlock x:Name="DailyEnergyCostSummaryText" x:FieldModifier="internal" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                            <ListView x:Name="DailyEnergyCostList" x:FieldModifier="internal" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Date}" Style="{StaticResource SecondaryTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Energy}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Cost}" Style="{StaticResource SecondaryTextStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource SectionTitleStyle}"
                                Text="Observed time" />
                            <Grid Height="8" CornerRadius="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="HistoryActiveColumn" x:FieldModifier="internal" Width="1*" />
                                    <ColumnDefinition x:Name="HistoryIdleColumn" x:FieldModifier="internal" Width="0*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#806E8D87" CornerRadius="4,0,0,4" />
                                <Border Grid.Column="1" Background="#60717A86" CornerRadius="0,4,4,0" />
                            </Grid>
                            <TextBlock
                                x:Name="HistoryActivityText" x:FieldModifier="internal"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Active and Idle evidence will appear here" />
                            <Grid Height="6" CornerRadius="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="HistoryStableColumn" x:FieldModifier="internal" Width="1*" />
                                    <ColumnDefinition x:Name="HistoryAttentionColumn" x:FieldModifier="internal" Width="0*" />
                                    <ColumnDefinition x:Name="HistoryWarningColumn" x:FieldModifier="internal" Width="0*" />
                                    <ColumnDefinition x:Name="HistoryCriticalColumn" x:FieldModifier="internal" Width="0*" />
                                    <ColumnDefinition x:Name="HistoryUnknownColumn" x:FieldModifier="internal" Width="0*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#80718A84" CornerRadius="3,0,0,3" />
                                <Border Grid.Column="1" Background="#809B8562" />
                                <Border Grid.Column="2" Background="#80B37652" />
                                <Border Grid.Column="3" Background="#80A45346" />
                                <Border Grid.Column="4" Background="#806F7780" CornerRadius="0,3,3,0" />
                            </Grid>
                            <TextBlock
                                x:Name="HistoryStateDurationText" x:FieldModifier="internal"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="State-duration evidence will appear here" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource SectionTitleStyle}"
                                Text="Timeline" />
                            <ListView
                                x:Name="HistoryEventsList" x:FieldModifier="internal"
                                AutomationProperties.AutomationId="HistoryEventsList"
                                IsItemClickEnabled="False"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:HistoryEventDisplayItem">
                                        <Grid Margin="0,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Time}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Title}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind Detail}"
                                                    Visibility="{x:Bind DetailVisibility}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="HistoryEventsEmptyText" x:FieldModifier="internal"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Meaningful state transitions will appear here." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
</UserControl>
