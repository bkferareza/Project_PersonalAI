<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Machine.App.Features.RuntimeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App.Features"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
<ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12,0,12,16" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Runtime" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Local processes and app-owned AI status" />
                        </StackPanel>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Top processes" />
                                <ItemsControl
                                    x:Name="TopProcessesList" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="TopProcessesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ProcessDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind Details}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="ProcessStatusText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="ProcessStatusText"
                                    Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Local AI" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="State" />
                                    <TextBlock
                                        x:Name="LocalAiStateText" x:FieldModifier="internal"
                                        AutomationProperties.AutomationId="LocalAiStateText"
                                        Grid.Column="1"
                                        Text="Loading..."
                                        TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="Runtime" />
                                    <TextBlock
                                        x:Name="LocalAiRuntimeText" x:FieldModifier="internal"
                                        AutomationProperties.AutomationId="LocalAiRuntimeText"
                                        Grid.Column="1"
                                        Text="Loading..."
                                        TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Loaded models" />
                                <ItemsControl
                                    x:Name="LocalAiRunningModelsList" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LocalAiRunningModelsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:LocalInferenceModelDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind ModelDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind RuntimeDetails}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="LocalAiLoadedModelsStatusText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LocalAiLoadedModelsStatusText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Loading..." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
</UserControl>
