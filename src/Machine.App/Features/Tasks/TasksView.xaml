<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Machine.App.Features.TasksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App.Features"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
<ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16,4,16,20" Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Tasks" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Read-only Windows Task Scheduler inventory" />
                            </StackPanel>
                            <Button
                                x:Name="RefreshTasksButton" x:FieldModifier="internal"
                                AutomationProperties.Name="Refresh scheduled tasks"
                                Content="Refresh"
                                Grid.Column="1" />
                        </Grid>
                        <TextBox
                            x:Name="TaskSearchBox" x:FieldModifier="internal"
                            AutomationProperties.Name="Search scheduled tasks"
                            PlaceholderText="Search name, path, author, or executable" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="TaskEnabledFilter" x:FieldModifier="internal"
                                AutomationProperties.Name="Filter scheduled tasks by enabled state"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">
                                <ComboBoxItem Content="All" Tag="all" />
                                <ComboBoxItem Content="Enabled" Tag="enabled" />
                                <ComboBoxItem Content="Disabled" Tag="disabled" />
                            </ComboBox>
                            <ComboBox
                                x:Name="TaskStateFilter" x:FieldModifier="internal"
                                AutomationProperties.Name="Filter scheduled tasks by runtime state"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Any state" Tag="all" />
                                <ComboBoxItem Content="Ready" Tag="Ready" />
                                <ComboBoxItem Content="Running" Tag="Running" />
                                <ComboBoxItem Content="Queued" Tag="Queued" />
                                <ComboBoxItem Content="Disabled" Tag="Disabled" />
                            </ComboBox>
                            <ComboBox
                                x:Name="TaskResultFilter" x:FieldModifier="internal"
                                AutomationProperties.Name="Filter scheduled tasks by last result"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Any result" Tag="all" />
                                <ComboBoxItem Content="Failed last run" Tag="failed" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="TasksSummaryText" x:FieldModifier="internal" Style="{StaticResource SecondaryTextStyle}" Text="Loading scheduled tasks" />
                        <ListView
                            x:Name="TasksList" x:FieldModifier="internal"
                            AutomationProperties.AutomationId="TasksList"
                            MaxHeight="600"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ScheduledTaskDisplayItem">
                                    <StackPanel Margin="0,6" Spacing="2">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind State}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Path}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ScheduleDetails}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind EvidenceDetails}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="TasksStatusText" x:FieldModifier="internal" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </ScrollViewer>
</UserControl>
