<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Machine.App.Features.ServicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App.Features"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
<ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16,4,16,20" Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Services" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Read-only Service Control Manager inventory" />
                            </StackPanel>
                            <Button
                                x:Name="RefreshServicesButton" x:FieldModifier="internal"
                                AutomationProperties.Name="Refresh services"
                                Content="Refresh"
                                Grid.Column="1" />
                        </Grid>
                        <TextBox
                            x:Name="ServiceSearchBox" x:FieldModifier="internal"
                            AutomationProperties.Name="Search services"
                            PlaceholderText="Search name or display name" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="ServiceStateFilter" x:FieldModifier="internal"
                                AutomationProperties.Name="Filter services by state"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">
                                <ComboBoxItem Content="All states" Tag="all" />
                                <ComboBoxItem Content="Running" Tag="Running" />
                                <ComboBoxItem Content="Stopped" Tag="Stopped" />
                                <ComboBoxItem Content="Pending" Tag="pending" />
                                <ComboBoxItem Content="Paused" Tag="Paused" />
                            </ComboBox>
                            <ComboBox
                                x:Name="ServiceStartTypeFilter" x:FieldModifier="internal"
                                AutomationProperties.Name="Filter services by start type"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0">
                                <ComboBoxItem Content="All start types" Tag="all" />
                                <ComboBoxItem Content="Automatic" Tag="automatic" />
                                <ComboBoxItem Content="Manual" Tag="Manual" />
                                <ComboBoxItem Content="Disabled" Tag="Disabled" />
                                <ComboBoxItem Content="Boot / system" Tag="boot" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="ServicesSummaryText" x:FieldModifier="internal" Style="{StaticResource SecondaryTextStyle}" Text="Loading services" />
                        <ListView
                            x:Name="ServicesList" x:FieldModifier="internal"
                            AutomationProperties.AutomationId="ServicesList"
                            MaxHeight="600"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ServiceDisplayItem">
                                    <Grid Margin="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Identity}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                            <TextBlock HorizontalAlignment="Right" Text="{x:Bind State}" />
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind StartDetails}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ServicesStatusText" x:FieldModifier="internal" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </ScrollViewer>
</UserControl>
