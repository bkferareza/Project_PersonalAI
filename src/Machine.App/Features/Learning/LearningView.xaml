<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Machine.App.Features.LearningView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App.Features"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
<ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12,4,12,16" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Learning Lab" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Live, inspectable machine learning from the first accepted sample" />
                        </StackPanel>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Live Learning" />
                                <TextBlock
                                    x:Name="LearningLiveContextText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningLiveContextText"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="Waiting for verified telemetry"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="LearningLiveLastObservationText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningLiveLastObservationText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="No intake attempt yet"
                                    TextWrapping="Wrap" />
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource MetricLabelStyle}" Text="LATEST INTAKE" />
                                    <TextBlock
                                        x:Name="LearningLiveAcceptanceText" x:FieldModifier="internal"
                                        AutomationProperties.AutomationId="LearningLiveAcceptanceText"
                                        FontWeight="SemiBold"
                                        Text="Waiting" />
                                    <TextBlock
                                        x:Name="LearningLiveAcceptanceReasonText" x:FieldModifier="internal"
                                        AutomationProperties.AutomationId="LearningLiveAcceptanceReasonText"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Waiting for the first verified intake attempt."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid ColumnSpacing="14" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="LIFETIME ACCEPTED" />
                                        <TextBlock x:Name="LearningLiveLifetimeText" x:FieldModifier="internal" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="THIS SESSION" />
                                        <TextBlock x:Name="LearningLiveSessionText" x:FieldModifier="internal" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="CONTEXT SAMPLES / DAYS" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LearningLiveContextEvidenceText" x:FieldModifier="internal" Text="0 / 0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="MATURITY / FRESHNESS" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LearningLiveMaturityText" x:FieldModifier="internal" Text="No evidence" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="POWER EVIDENCE" />
                                        <TextBlock x:Name="LearningLivePowerMaturityText" x:FieldModifier="internal" Text="No evidence" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="2" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="LEARNED DIMENSIONS" />
                                        <TextBlock Text="Activity · CPU · Memory · Network · eligible power" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock FontWeight="SemiBold" Text="Signals being learned now" />
                                <TextBlock
                                    x:Name="LearningLiveSignalsEmptyText" x:FieldModifier="internal"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Signal details appear with the first accepted sample." />
                                <ListView
                                    x:Name="LearningLiveSignalsList" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningLiveSignalsList"
                                    MaxHeight="320"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:LearningSignalDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Signal}" />
                                                <TextBlock Text="{x:Bind CurrentValue}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind LearnedValue}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Recent Learning Changes" />
                                <TextBlock
                                    x:Name="LearningActivityStatusText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningActivityStatusText"
                                    FontWeight="SemiBold"
                                    Text="Starting" />
                                <TextBlock
                                    x:Name="LearningActivityEmptyText" x:FieldModifier="internal"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="No bounded learning changes recorded yet." />
                                <ListView
                                    x:Name="LearningActivityEventsList" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningActivityEventsList"
                                    MaxHeight="360"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:LearningActivityDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="1">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Header}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Bounded audit: detailed intake changes retain for 48 hours; lifecycle and persistence events retain for 14 days."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="AI Knowledge" />
                                <TextBlock
                                    x:Name="LearningAiKnowledgeSummaryText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningAiKnowledgeSummaryText"
                                    FontWeight="SemiBold"
                                    Text="No bounded AI knowledge payload assembled yet"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="LearningAiKnowledgeEvidenceText" x:FieldModifier="internal"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Learning and forecast evidence availability is inspected locally."
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="14" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="Runtime" />
                                    <TextBlock x:Name="LearningAiKnowledgeRuntimeText" x:FieldModifier="internal" Grid.Column="1" Text="Checking" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Model" />
                                    <TextBlock x:Name="LearningAiKnowledgeModelText" x:FieldModifier="internal" Grid.Column="1" Grid.Row="1" Text="Checking" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Prompt" />
                                    <TextBlock x:Name="LearningAiKnowledgePromptText" x:FieldModifier="internal" Grid.Column="1" Grid.Row="2" Text="Checking" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Validation" />
                                    <TextBlock x:Name="LearningAiKnowledgeValidationText" x:FieldModifier="internal" Grid.Column="1" Grid.Row="3" Text="No generation yet" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="The normalized whole-machine evidence payload will remain bounded and will never include raw persistence files, IP, location, secrets, or the private runtime key."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="9">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Learned usage outlook" />
                                <TextBlock
                                    x:Name="LearningCurrentHourUsageText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningCurrentHourUsageText"
                                    FontWeight="SemiBold"
                                    Text="Still gathering repeated activity evidence"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="LearningCurrentHourUsageEvidenceText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningCurrentHourUsageEvidenceText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="No completed historical day is available yet"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="14" RowSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="NEXT OBSERVED HOUR" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningNextHourEnergyText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningNextHourEnergyText"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="Unavailable"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningNextHourEnergyRangeText" x:FieldModifier="internal"
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="Current power evidence is not yet sufficient"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="ESTIMATED COST" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningNextHourCostText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningNextHourCostText"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="Unavailable"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningNextHourCostRangeText" x:FieldModifier="internal"
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="Estimated cost range unavailable"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="PROJECTED END OF DAY" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningEndOfDayEnergyText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningEndOfDayEnergyText"
                                            FontWeight="SemiBold"
                                            Text="Unavailable"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningEndOfDayEnergyRangeText" x:FieldModifier="internal"
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="No trustworthy remaining-day energy range"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="PROJECTED ESTIMATED COST" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningEndOfDayCostText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningEndOfDayCostText"
                                            FontWeight="SemiBold"
                                            Text="Unavailable"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningEndOfDayCostRangeText" x:FieldModifier="internal"
                                            Style="{StaticResource SecondaryTextStyle}"
                                            Text="Estimated cost range unavailable"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    x:Name="LearningForecastEvidenceText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningForecastEvidenceText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="End-of-day projection unavailable while activity evidence accumulates."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Observed PC electricity only. Unobserved or powered-off time is never classified as Idle, and estimates are not the household bill."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Memory" />
                                <TextBlock
                                    x:Name="LearningPageMemoryStateText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningPageMemoryStateText"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="Behavior memory · Waiting for first evidence"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="LearningPageMemoryEvidenceText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningPageMemoryEvidenceText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="0 baselines · 0 compact profiles · 0 recognized patterns"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="14" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="OBSERVED" />
                                        <TextBlock
                                            x:Name="LearningPageObservedText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningPageObservedText"
                                            FontWeight="SemiBold"
                                            Text="0m across 1 Matasuri session"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="ACCEPTED OBSERVATIONS" />
                                        <TextBlock
                                            x:Name="LearningPageLifetimeObservationsText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningPageLifetimeObservationsText"
                                            Text="0 lifetime" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="LAYER 1 · BASELINES" />
                                        <TextBlock
                                            x:Name="LearningPageContextCountText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningPageContextCountText"
                                            Text="0 / 48" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="LAYER 2 · PROFILES" />
                                        <TextBlock
                                            x:Name="LearningPageEstablishedProfilesText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningPageEstablishedProfilesText"
                                            Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="LAYER 3 · PATTERNS" />
                                        <TextBlock
                                            x:Name="LearningPageBroaderPatternCountText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningPageBroaderPatternCountText"
                                            Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="2" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="MATASURI SESSIONS" />
                                        <TextBlock
                                            x:Name="LearningPageSessionCountText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningPageSessionCountText"
                                            Text="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="FIRST LEARNED" />
                                        <TextBlock
                                            x:Name="LearningPageFirstLearnedText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningPageFirstLearnedText"
                                            Text="Not yet observed"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="3" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="LAST LEARNED" />
                                        <TextBlock
                                            x:Name="LearningPageLastLearnedText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningPageLastLearnedText"
                                            Text="Not yet observed"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Spacing="2">
                                        <TextBlock
                                            Style="{StaticResource MetricLabelStyle}"
                                            Text="RAW JOURNAL IN MEMORY"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningPageRawObservationsText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningPageRawObservationsText"
                                            Text="0 / 2,880" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="4" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="RECENT EPISODES" />
                                        <TextBlock
                                            x:Name="LearningPageRecentEpisodesText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningPageRecentEpisodesText"
                                            Text="0 / 200" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="Current context" />
                                    <TextBlock
                                        x:Name="LearningPageCurrentContextText" x:FieldModifier="internal"
                                        AutomationProperties.AutomationId="LearningPageCurrentContextText"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Waiting for verified telemetry" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="LearningPageMemoryPersistenceText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningPageMemoryPersistenceText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Schema v4 · Persistence not yet available"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Live context evidence" />
                                <Grid ColumnSpacing="14" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="CURRENT BUCKET" />
                                        <TextBlock x:Name="LearningPageCurrentBucketText" x:FieldModifier="internal" Text="Waiting" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="SAMPLES" />
                                        <TextBlock x:Name="LearningPageCurrentSamplesText" x:FieldModifier="internal" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="OBSERVED DAYS" />
                                        <TextBlock x:Name="LearningPageObservedDaysText" x:FieldModifier="internal" Text="0 / 7" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="CONTEXT MATURITY" />
                                        <TextBlock x:Name="LearningPageConfidenceText" x:FieldModifier="internal" Text="No evidence" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    x:Name="LearningPageConfidenceRulesText" x:FieldModifier="internal"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Evidence is inspectable immediately. Maturity limits authority; freshness measures recency separately." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="7">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Recurring Behavior" />
                                <TextBlock
                                    x:Name="LearningPatternReadinessHeadlineText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningPatternReadinessHeadlineText"
                                    FontWeight="SemiBold"
                                    Text="No recurring pattern established"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="LearningPatternProfileReadinessText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningPatternProfileReadinessText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="0 profiles · 0 meet 168 samples · 0 meet 7 days · 0 established"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="LearningPatternPairReadinessText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningPatternPairReadinessText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="0 same-activity adjacent pairs · 0 meet evidence thresholds · 0 compatible"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="LearningPatternReadinessReasonText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningPatternReadinessReasonText"
                                    Text="Pattern readiness is still being evaluated from verified evidence."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Recomputed after profile maturity, freshness, compatibility, or restored-state changes."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="9">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Current power behavior" />
                                <TextBlock
                                    x:Name="LearningCurrentPowerContextText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningCurrentPowerContextText"
                                    FontWeight="SemiBold"
                                    Text="Waiting for a learned context"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="14" RowSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="TYPICAL ESTIMATED POWER" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningCurrentPowerTypicalText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningCurrentPowerTypicalText"
                                            FontSize="22"
                                            FontWeight="SemiBold"
                                            Text="No authoritative power range yet"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="LEARNED RANGE" />
                                        <TextBlock
                                            x:Name="LearningCurrentPowerRangeText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningCurrentPowerRangeText"
                                            FontWeight="SemiBold"
                                            Text="Unavailable"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="POWER EVIDENCE" />
                                        <TextBlock
                                            x:Name="LearningCurrentPowerEvidenceText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningCurrentPowerEvidenceText"
                                            Text="Insufficient"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="PROJECTED ELECTRICITY COST" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningCurrentPowerCostText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningCurrentPowerCostText"
                                            FontWeight="SemiBold"
                                            Text="Unavailable"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    x:Name="LearningCurrentPowerCostRangeText" x:FieldModifier="internal"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Projected range unavailable"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="LearningCurrentPowerRateText" x:FieldModifier="internal"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Published residential reference rate unavailable"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="9">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Today vs learned normal" />
                                <TextBlock
                                    x:Name="LearningTodayComparisonStatusText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningTodayComparisonStatusText"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="Learned-normal comparison unavailable"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="LearningTodayComparisonDetailText" x:FieldModifier="internal"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Power behavior is not yet available for all observed contexts."
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="14" RowSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="OBSERVED" />
                                        <TextBlock
                                            x:Name="LearningTodayObservedEnergyText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningTodayObservedEnergyText"
                                            FontWeight="SemiBold"
                                            Text="Beginning now" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="LEARNED EXPECTATION" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningTodayExpectedEnergyText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningTodayExpectedEnergyText"
                                            FontWeight="SemiBold"
                                            Text="Unavailable without complete learned coverage"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="OBSERVED ESTIMATED COST" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningTodayActualCostText" x:FieldModifier="internal"
                                            Text="Unavailable"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="LEARNED EXPECTED COST" TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="LearningTodayExpectedCostText" x:FieldModifier="internal"
                                            Text="Unavailable without complete learned coverage"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="OBSERVED DURATION" />
                                        <TextBlock
                                            x:Name="LearningTodayObservedDurationText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningTodayObservedDurationText"
                                            Text="0m" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.Row="2" Spacing="2">
                                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="LEARNED COVERAGE" />
                                        <TextBlock
                                            x:Name="LearningTodayCoverageText" x:FieldModifier="internal"
                                            AutomationProperties.AutomationId="LearningTodayCoverageText"
                                            Text="0%"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Compared at the last fully accepted History checkpoint so energy and observed duration stay aligned."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Learned Contexts" />
                                <TextBlock
                                    x:Name="LearningProfilesEmptyText" x:FieldModifier="internal"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="No accepted context evidence yet." />
                                <ListView
                                    x:Name="LearningProfilesList" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningProfilesList"
                                    MaxHeight="360"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:LearningProfileDisplayItem">
                                            <StackPanel Margin="0,5" Opacity="{x:Bind Opacity}" Spacing="3">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Header}" />
                                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Evidence}" />
                                                <Grid ColumnSpacing="12" Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="1">
                                                        <TextBlock FontWeight="SemiBold" Text="CPU" />
                                                        <TextBlock Text="{x:Bind CpuValue}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock FontWeight="SemiBold" Text="Memory" />
                                                        <TextBlock Text="{x:Bind MemoryValue}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                 <StackPanel Margin="0,3,0,0" Spacing="1">
                                                     <TextBlock FontWeight="SemiBold" Text="Network" />
                                                     <TextBlock Text="{x:Bind NetworkValue}" TextWrapping="Wrap" />
                                                 </StackPanel>
                                                 <StackPanel Margin="0,3,0,0" Spacing="1">
                                                     <TextBlock FontWeight="SemiBold" Text="Estimated wall power" />
                                                     <TextBlock Text="{x:Bind PowerValue}" TextWrapping="Wrap" />
                                                 </StackPanel>
                                                 <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Reinforcement}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Established recurring patterns" />
                                <TextBlock
                                    x:Name="LearningPatternsEmptyText" x:FieldModifier="internal"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="No recurring pattern is established; the exact current blocker appears above." />
                                <ListView
                                    x:Name="LearningPatternsList" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearningPatternsList"
                                    MaxHeight="280"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:LearningPatternDisplayItem">
                                            <StackPanel Margin="0,5" Spacing="3">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Header}" />
                                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Status}" />
                                                <Grid ColumnSpacing="12" Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="1">
                                                        <TextBlock FontWeight="SemiBold" Text="CPU" />
                                                        <TextBlock Text="{x:Bind CpuValue}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock FontWeight="SemiBold" Text="Memory" />
                                                        <TextBlock Text="{x:Bind MemoryValue}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{x:Bind NetworkValue}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Evidence}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Learned evidence" />
                                <TextBlock
                                    x:Name="LearningItemsEmptyText" x:FieldModifier="internal"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Provisional learned items will appear after enough verified evidence accumulates." />
                                <ListView
                                    x:Name="LearnedItemsList" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="LearnedItemsList"
                                    MaxHeight="300"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:LearnedItemDisplayItem">
                                            <StackPanel Margin="0,5" Spacing="2">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Label}" />
                                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Evidence}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Recent episodes" />
                                <TextBlock
                                    x:Name="LearningEpisodesEmptyText" x:FieldModifier="internal"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="No completed aggregate episodes yet." />
                                <ListView
                                    x:Name="RecentLearningEpisodesList" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="RecentLearningEpisodesList"
                                    MaxHeight="420"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:LearningEpisodeDisplayItem">
                                            <StackPanel Margin="0,5" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Header}" />
                                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Context}" />
                                                <TextBlock Margin="0,2,0,0" Text="{x:Bind CpuDetails}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind MemoryDetails}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind OutcomeAndFindings}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Learning diagnostics" />
                                <Grid ColumnSpacing="14" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="Learning data" />
                                    <TextBlock x:Name="LearningDataHealthText" x:FieldModifier="internal" Grid.Column="1" Text="Not yet persisted" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Accepted this session" />
                                    <TextBlock x:Name="LearningAcceptedText" x:FieldModifier="internal" Grid.Column="1" Grid.Row="1" Text="0" />
                                    <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Throttled this session" />
                                    <TextBlock x:Name="LearningThrottledText" x:FieldModifier="internal" Grid.Column="1" Grid.Row="2" Text="0" />
                                    <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Skipped this session" />
                                    <TextBlock x:Name="LearningSkippedText" x:FieldModifier="internal" Grid.Column="1" Grid.Row="3" Text="0" />
                                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Last accepted" />
                                    <TextBlock x:Name="LearningLastAcceptedText" x:FieldModifier="internal" Grid.Column="1" Grid.Row="4" Text="Not yet observed" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Persistence" />
                                    <TextBlock x:Name="LearningDirtyStateText" x:FieldModifier="internal" Grid.Column="1" Grid.Row="5" Text="No pending changes" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Last persisted" />
                                    <TextBlock x:Name="LearningLastPersistedText" x:FieldModifier="internal" Grid.Column="1" Grid.Row="6" Text="Not yet persisted" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="7" FontWeight="SemiBold" Text="Schema" />
                                    <TextBlock x:Name="LearningSchemaText" x:FieldModifier="internal" Grid.Column="1" Grid.Row="7" Text="v3" />
                                    <TextBlock Grid.Row="8" FontWeight="SemiBold" Text="AI runtime" />
                                    <TextBlock x:Name="LearningAiRuntimeText" x:FieldModifier="internal" Grid.Column="1" Grid.Row="8" Text="Checking" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="9" FontWeight="SemiBold" Text="Model" />
                                    <TextBlock x:Name="LearningAiModelText" x:FieldModifier="internal" Grid.Column="1" Grid.Row="9" Text="Checking" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
</UserControl>
