<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Machine.App.Features.SoftwareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App.Features"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
<ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12,0,12,16" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Software" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Searchable read-only registrations" />
                        </StackPanel>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Classic desktop" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Registrations reported by Windows. No usage or removal inference." />
                                <TextBox
                                    x:Name="SoftwareSearchBox" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="SoftwareSearchBox"
                                    PlaceholderText="Search by name or publisher" />
                                <TextBlock
                                    x:Name="SoftwareInventorySummaryText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="SoftwareInventorySummaryText"
                                    Text="0 registrations found&#x0a;Showing 0"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="RefreshSoftwareButton" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="RefreshSoftwareButton"
                                    Content="Refresh classic software"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False" />
                                <ListView
                                    x:Name="InstalledSoftwareList" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="InstalledSoftwareList"
                                    MaxHeight="260"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:InstalledSoftwareDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind PublisherAndVersion}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind RegistrationDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind InstallLocationDetails}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="SoftwareInventoryStatusText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="SoftwareInventoryStatusText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Loading..." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Packaged applications" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Current-user MSIX/AppX packages. Source and update status are not inferred." />
                                <TextBox
                                    x:Name="PackagedSoftwareSearchBox" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="PackagedSoftwareSearchBox"
                                    PlaceholderText="Search by name, publisher, or package family" />
                                <TextBlock
                                    x:Name="PackagedSoftwareInventorySummaryText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="PackagedSoftwareInventorySummaryText"
                                    Text="0 packages found&#x0a;Showing 0"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="RefreshPackagedSoftwareButton" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="RefreshPackagedSoftwareButton"
                                    Content="Refresh packaged applications"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False" />
                                <ListView
                                    x:Name="PackagedSoftwareList" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="PackagedSoftwareList"
                                    MaxHeight="260"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:PackagedSoftwareDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind DisplayName}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind PublisherVersionArchitecture}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind PackageFamilyDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind PackageFlagsDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind InstalledLocationDetails}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="PackagedSoftwareInventoryStatusText" x:FieldModifier="internal"
                                    AutomationProperties.AutomationId="PackagedSoftwareInventoryStatusText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Loading..." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
</UserControl>
