<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Machine.App.Features.HardwareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App.Features"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
<ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="18,4,18,20" Spacing="18">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Hardware" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Local driver-provided telemetry" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource MetricLabelStyle}"
                                Text="PROCESSOR" />
                            <TextBlock x:Name="CpuProcessorNameText" x:FieldModifier="internal" FontSize="20" FontWeight="SemiBold" Text="Detecting processor" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="22" RowSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2"><TextBlock x:Name="CpuLoadText" x:FieldModifier="internal" FontSize="22" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="CPU load" /></StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="CpuClockText" x:FieldModifier="internal" FontSize="22" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Effective frequency" /></StackPanel>
                                <StackPanel Grid.Row="1" Spacing="2"><TextBlock x:Name="CpuPowerText" x:FieldModifier="internal" FontSize="18" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Package power" /></StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2"><TextBlock x:Name="CpuTemperatureText" x:FieldModifier="internal" FontSize="14" Text="—" TextWrapping="Wrap" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Temperature" /></StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource MetricLabelStyle}"
                                Text="GRAPHICS" />
                            <TextBlock
                                x:Name="GpuAdapterNameText" x:FieldModifier="internal"
                                AutomationProperties.AutomationId="GpuAdapterNameText"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Text="Detecting graphics hardware"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="GpuProviderStatusText" x:FieldModifier="internal"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Detailed GPU telemetry is loading" />
                        </StackPanel>
                        <Grid ColumnSpacing="22" RowSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="GpuUtilizationText" x:FieldModifier="internal" FontSize="28" FontWeight="SemiBold" Text="—" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="GPU load" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="GpuMemoryText" x:FieldModifier="internal" FontSize="22" FontWeight="SemiBold" Text="—" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="VRAM used / total" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="2">
                                <TextBlock x:Name="GpuTemperatureText" x:FieldModifier="internal" FontSize="22" FontWeight="SemiBold" Text="—" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Temperature" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2">
                                <TextBlock x:Name="GpuPowerText" x:FieldModifier="internal" FontSize="22" FontWeight="SemiBold" Text="—" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Board power" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Spacing="2">
                                <TextBlock x:Name="GpuGraphicsClockText" x:FieldModifier="internal" FontSize="18" FontWeight="SemiBold" Text="—" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Graphics clock" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="2" Spacing="2">
                                <TextBlock x:Name="GpuMemoryClockText" x:FieldModifier="internal" FontSize="18" FontWeight="SemiBold" Text="—" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Memory clock" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource MetricLabelStyle}" Text="POWER" />
                            <TextBlock x:Name="PowerWallText" x:FieldModifier="internal" FontSize="24" FontWeight="SemiBold" Text="Estimated wall power unavailable" />
                            <TextBlock x:Name="PowerRangeText" x:FieldModifier="internal" Style="{StaticResource SecondaryTextStyle}" Text="Measured GPU board power is used when the driver provides it; CPU and wall draw remain estimates." TextWrapping="Wrap" />
                            <TextBlock x:Name="EnergySessionText" x:FieldModifier="internal" Style="{StaticResource SecondaryTextStyle}" Text="Energy begins after an observed power interval" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource MetricLabelStyle}" Text="STORAGE HEALTH" />
                            <TextBlock x:Name="StorageHealthText" x:FieldModifier="internal" FontSize="18" Text="Loading Windows-reported storage health" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Missing reliability fields are unavailable, not healthy readings. Windows-reported device health is distinct from estimates." TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock
                                Style="{StaticResource MetricLabelStyle}"
                                Text="COOLING" />
                            <TextBlock x:Name="GpuFanText" x:FieldModifier="internal" FontSize="18" Text="—" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Unsupported values stay unavailable. Matasuri does not set thermal severity or tune hardware." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
</UserControl>
