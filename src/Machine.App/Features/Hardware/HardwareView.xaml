<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Machine.App.Features.HardwareView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Machine.App.Features" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="22,10,22,28" Spacing="28">
      <StackPanel Spacing="3"><TextBlock Style="{StaticResource PageTitleStyle}" Text="Hardware" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Local hardware evidence and clearly labeled estimates" /></StackPanel>
      <StackPanel Spacing="12">
        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="PROCESSOR" />
        <TextBlock x:Name="CpuProcessorNameText" x:FieldModifier="internal" FontSize="21" FontWeight="SemiBold" Text="Detecting processor" TextWrapping="Wrap" />
        <TextBlock x:Name="CpuProviderStatusText" x:FieldModifier="internal" Style="{StaticResource SecondaryTextStyle}" Text="Windows metadata and safe frequency telemetry" TextWrapping="Wrap" />
        <Grid ColumnSpacing="28" RowSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Spacing="3"><TextBlock x:Name="CpuLoadText" x:FieldModifier="internal" FontSize="26" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="CPU load" /></StackPanel>
          <StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="CpuClockText" x:FieldModifier="internal" FontSize="26" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Effective clock" /></StackPanel>
          <StackPanel Grid.Row="1" Spacing="3"><TextBlock x:Name="CpuPowerText" x:FieldModifier="internal" FontSize="22" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Package power · estimated" /></StackPanel>
          <StackPanel Grid.Column="1" Grid.Row="1" Spacing="3"><TextBlock x:Name="CpuTemperatureText" x:FieldModifier="internal" FontSize="22" FontWeight="SemiBold" Text="Unavailable" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Temperature" /></StackPanel>
        </Grid>
        <TextBlock x:Name="CpuTemperatureNoteText" x:FieldModifier="internal" Style="{StaticResource SecondaryTextStyle}" Text="CPU package temperature is not exposed by the current safe telemetry path." TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="12">
        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="GRAPHICS" />
        <TextBlock x:Name="GpuAdapterNameText" x:FieldModifier="internal" AutomationProperties.AutomationId="GpuAdapterNameText" FontSize="21" FontWeight="SemiBold" Text="Detecting graphics hardware" TextWrapping="Wrap" />
        <TextBlock x:Name="GpuProviderStatusText" x:FieldModifier="internal" Style="{StaticResource SecondaryTextStyle}" Text="NVML driver telemetry" />
        <Grid ColumnSpacing="28" RowSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Spacing="3"><TextBlock x:Name="GpuUtilizationText" x:FieldModifier="internal" FontSize="26" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="GPU load" /></StackPanel>
          <StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="GpuMemoryText" x:FieldModifier="internal" FontSize="22" FontWeight="SemiBold" Text="—" TextWrapping="Wrap" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="VRAM used / total" /></StackPanel>
          <StackPanel Grid.Row="1" Spacing="3"><TextBlock x:Name="GpuTemperatureText" x:FieldModifier="internal" FontSize="22" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Temperature" /></StackPanel>
          <StackPanel Grid.Column="1" Grid.Row="1" Spacing="3"><TextBlock x:Name="GpuPowerText" x:FieldModifier="internal" FontSize="22" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Board power · measured" /></StackPanel>
          <StackPanel Grid.Row="2" Spacing="3"><TextBlock x:Name="GpuGraphicsClockText" x:FieldModifier="internal" FontSize="18" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Graphics clock" /></StackPanel>
          <StackPanel Grid.Column="1" Grid.Row="2" Spacing="3"><TextBlock x:Name="GpuMemoryClockText" x:FieldModifier="internal" FontSize="18" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Memory clock" /></StackPanel>
        </Grid>
      </StackPanel>
      <StackPanel Spacing="12"><TextBlock Style="{StaticResource MetricLabelStyle}" Text="POWER" /><TextBlock x:Name="PowerWallText" x:FieldModifier="internal" FontSize="34" FontWeight="SemiBold" Text="Unavailable" /><TextBlock Text="Estimated wall draw" Style="{StaticResource SecondaryTextStyle}" /><StackPanel Spacing="2"><TextBlock x:Name="PowerRangeText" x:FieldModifier="internal" FontSize="18" FontWeight="SemiBold" Text="Awaiting component evidence" /><TextBlock x:Name="PowerConfidenceText" x:FieldModifier="internal" Style="{StaticResource SecondaryTextStyle}" Text="Estimate quality unavailable" /></StackPanel><Grid ColumnSpacing="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock x:Name="EnergySessionText" x:FieldModifier="internal" FontSize="20" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Session energy · estimated" /></StackPanel><StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="EnergyTodayText" x:FieldModifier="internal" FontSize="20" FontWeight="SemiBold" Text="—" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Today · observed" /></StackPanel></Grid><TextBlock x:Name="PowerEvidenceText" x:FieldModifier="internal" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Text="Measured GPU board power is used when available. CPU and platform values are estimated." /></StackPanel>
      <StackPanel Spacing="12"><TextBlock Style="{StaticResource MetricLabelStyle}" Text="STORAGE" /><TextBlock x:Name="StorageHealthText" x:FieldModifier="internal" FontSize="20" FontWeight="SemiBold" Text="Loading physical storage" TextWrapping="Wrap" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Windows-reported health. Unavailable fields are left unknown rather than assumed healthy." TextWrapping="Wrap" /><ListView x:Name="StorageDevicesList" x:FieldModifier="internal" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="local:StorageDeviceDisplayItem"><StackPanel Margin="0,8,0,10" Spacing="3"><TextBlock FontSize="17" FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Identity}" TextWrapping="Wrap" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Health}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
