<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Machine.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="MatasuriAtmosphereBrush" Color="#263D5260" />
            <SolidColorBrush x:Key="MatasuriStateAccentBrush" Color="#FF718A84" />
            <SolidColorBrush x:Key="MatasuriSurfaceBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="MatasuriElevatedSurfaceBrush" Color="#2AFFFFFF" />
            <SolidColorBrush x:Key="MatasuriHairlineBrush" Color="#22FFFFFF" />
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter
                    Property="Background"
                    Value="{StaticResource MatasuriSurfaceBrush}" />
                <Setter
                    Property="BorderBrush"
                    Value="{StaticResource MatasuriHairlineBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,14" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="DashboardCloseButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="32" />
            </Style>
            <Style x:Key="MatasuriNavigationButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="10,5" />
            </Style>
            <Style x:Key="NavigationGroupStyle" TargetType="TextBlock">
                <Setter Property="CharacterSpacing" Value="140" />
                <Setter Property="FontSize" Value="9" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="Margin" Value="10,13,0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
