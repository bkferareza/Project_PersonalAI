<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Machine.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App"
    Title="Machine">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid
        x:Name="MainContent"
        Background="Transparent"
        GotFocus="OnMainContentGotFocus"
        Loaded="OnMainContentLoaded"
        LostFocus="OnMainContentLostFocus">
        <Grid.Resources>
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter
                    Property="Background"
                    Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter
                    Property="BorderBrush"
                    Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="CompactShell"
            AutomationProperties.AutomationId="CompactShell"
            Background="Transparent"
            Grid.Row="0"
            Height="96"
            Visibility="Collapsed">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.16" />
            </Grid.OpacityTransition>
            <Grid
                x:Name="CompactPresenceSurface"
                AutomationProperties.AutomationId="CompactPresenceSurface"
                AutomationProperties.HelpText="Open the Machine dashboard"
                AutomationProperties.Name="Open Machine dashboard"
                Background="Transparent"
                IsTabStop="True"
                ToolTipService.ToolTip="{x:Null}">
                <Border
                    x:Name="CompactContextPanel"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="28"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Visibility="Collapsed">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.16" />
                    </Border.OpacityTransition>
                    <Grid Margin="102,12,14,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="PresenceContextStateText"
                            AutomationProperties.AutomationId="PresenceContextStateText"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Unknown" />
                        <TextBlock
                            x:Name="CompactInsightPreviewText"
                            AutomationProperties.AutomationId="CompactInsightPreviewText"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Grid.Row="1"
                            MaxLines="2"
                            Text="Watching for a meaningful change."
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="PresenceTelemetryText"
                            AutomationProperties.AutomationId="PresenceTelemetryText"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Grid.Row="2"
                            Text="CPU unavailable &#x00B7; Memory unavailable"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
                <Grid
                    x:Name="PresenceCoreHost"
                    AutomationProperties.AccessibilityView="Raw"
                    Height="88"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Width="88">
                    <Grid
                        x:Name="PresencePulseLayer"
                        RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform
                                x:Name="PresencePulseTransform"
                                ScaleX="1"
                                ScaleY="1" />
                        </Grid.RenderTransform>
                        <Ellipse
                            x:Name="PresenceOuterGlow"
                            Fill="#FF83DFFF"
                            Height="82"
                            Opacity="0.10"
                            Width="82" />
                        <Ellipse
                            x:Name="PresenceEnergyLayer"
                            Fill="#FF7166F2"
                            Height="68"
                            Opacity="0.22"
                            Width="68" />
                        <Ellipse
                            x:Name="PresenceCoreGlow"
                            Fill="#FFC7F1FF"
                            Height="56"
                            Opacity="0.24"
                            Width="56" />
                        <Ellipse
                            x:Name="PresenceCore"
                            Height="42"
                            Width="42">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.35,0.3" GradientOrigin="0.35,0.3">
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#FFC9F4FF" Offset="0.28" />
                                    <GradientStop Color="#FF659FF7" Offset="0.66" />
                                    <GradientStop Color="#FF6347B8" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse
                            x:Name="PresenceCoreRing"
                            Height="58"
                            Opacity="0.6"
                            Stroke="#FFB8EAFF"
                            StrokeThickness="1"
                            Width="58" />
                        <Ellipse
                            Height="46"
                            Opacity="0.34"
                            Stroke="#FFC7F1FF"
                            StrokeThickness="0.75"
                            Width="46" />
                    </Grid>
                    <Ellipse
                        x:Name="PresenceOrbit"
                        Height="82"
                        Opacity="0.34"
                        RenderTransformOrigin="0.5,0.5"
                        Stroke="#FF9FDBFF"
                        StrokeDashArray="1,3.2"
                        StrokeThickness="1"
                        Width="82">
                        <Ellipse.RenderTransform>
                            <RotateTransform
                                x:Name="PresenceOrbitTransform" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse
                        Height="72"
                        Opacity="0.2"
                        Stroke="#FFBFCBFF"
                        StrokeDashArray="0.7,4.4"
                        StrokeThickness="0.75"
                        Width="72" />
                    <Grid
                        x:Name="PresenceSweepHost"
                        Height="64"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Width="64">
                        <Ellipse
                            x:Name="PresenceSweep"
                            Height="18"
                            Opacity="0.48"
                            VerticalAlignment="Center"
                            Width="30">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#B8E6FAFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <TranslateTransform
                                    x:Name="PresenceSweepTransform"
                                    X="-30" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <NavigationView
            x:Name="DetailsPanel"
            AutomationProperties.AutomationId="DetailsPanel"
            BackRequested="OnDashboardBackRequested"
            CompactPaneLength="44"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            IsBackButtonVisible="Visible"
            IsBackEnabled="True"
            IsPaneOpen="False"
            IsSettingsVisible="False"
            Margin="6,2,6,4"
            OpenPaneLength="140"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="OnDashboardNavigationSelectionChanged"
            Visibility="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="OverviewNavigationItem"
                    AutomationProperties.AutomationId="OverviewNavigationItem"
                    Content="Overview"
                    IsSelected="True"
                    Tag="overview">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.AutomationId="StorageNavigationItem"
                    Content="Storage"
                    Tag="storage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.AutomationId="SoftwareNavigationItem"
                    Content="Software"
                    Tag="software">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.AutomationId="StartupNavigationItem"
                    Content="Startup"
                    Tag="startup">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.AutomationId="RuntimeNavigationItem"
                    Content="Runtime"
                    Tag="runtime">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <ScrollViewer
                    x:Name="OverviewPage"
                    AutomationProperties.AutomationId="OverviewPage"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12,0,12,16" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Overview" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Verified local machine context" />
                        </StackPanel>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Style="{StaticResource MetricLabelStyle}"
                                    Text="THIS MACHINE" />
                                <TextBlock
                                    x:Name="DeviceNameText"
                                    AutomationProperties.AutomationId="DeviceNameText"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="Loading..."
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        x:Name="OperatingSystemText"
                                        AutomationProperties.AutomationId="OperatingSystemText"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Loading..." />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="&#x00B7;" />
                                    <TextBlock
                                        x:Name="ArchitectureText"
                                        AutomationProperties.AutomationId="ArchitectureText"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Loading..." />
                                </StackPanel>
                                <TextBlock
                                    x:Name="LoadStatusText"
                                    AutomationProperties.AutomationId="LoadStatusText"
                                    Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource MetricLabelStyle}"
                                    Text="DETERMINISTIC STATE" />
                                <TextBlock
                                    x:Name="FindingsOverallStateText"
                                    AutomationProperties.AutomationId="FindingsOverallStateText"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Text="Unknown" />
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DashboardCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource MetricLabelStyle}"
                                        Text="CPU" />
                                    <TextBlock
                                        x:Name="CpuUsageText"
                                        AutomationProperties.AutomationId="CpuUsageText"
                                        FontSize="23"
                                        FontWeight="SemiBold"
                                        Text="Loading..."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Current usage" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Style="{StaticResource DashboardCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource MetricLabelStyle}"
                                        Text="MEMORY" />
                                    <TextBlock
                                        x:Name="MemoryUsageText"
                                        AutomationProperties.AutomationId="MemoryUsageText"
                                        FontSize="19"
                                        FontWeight="SemiBold"
                                        Text="Loading..."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Used / total" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock
                            x:Name="TelemetryStatusText"
                            AutomationProperties.AutomationId="TelemetryStatusText"
                            Style="{StaticResource SecondaryTextStyle}"
                            Visibility="Collapsed" />
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Current findings" />
                                <TextBlock
                                    x:Name="FindingsSummaryText"
                                    AutomationProperties.AutomationId="FindingsSummaryText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Resource telemetry and readable system-volume data are unavailable." />
                                <ItemsControl
                                    x:Name="CurrentFindingsList"
                                    AutomationProperties.AutomationId="CurrentFindingsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:MachineFindingDisplayItem">
                                            <StackPanel Margin="0,3" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Header}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind Detail}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="9">
                                <Grid>
                                    <TextBlock
                                        Style="{StaticResource SectionTitleStyle}"
                                        Text="Local insight" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Right"
                                        Text="Event-driven" />
                                </Grid>
                                <TextBlock
                                    x:Name="MachineExplanationText"
                                    AutomationProperties.AutomationId="MachineExplanationText"
                                    FontSize="16"
                                    LineHeight="23"
                                    Text="Watching for a meaningful change."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="MachineExplanationStatusText"
                                    AutomationProperties.AutomationId="MachineExplanationStatusText"
                                    Style="{StaticResource SecondaryTextStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="MachineExplanationMetadataText"
                                        AutomationProperties.AutomationId="MachineExplanationMetadataText"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed" />
                                    <ProgressRing
                                        x:Name="MachineExplanationProgressRing"
                                        AutomationProperties.AutomationId="MachineExplanationProgressRing"
                                        Grid.Column="1"
                                        Height="18"
                                        IsActive="False"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Width="18" />
                                    <Button
                                        x:Name="ExplainMachineStateButton"
                                        AutomationProperties.AutomationId="ExplainMachineStateButton"
                                        Click="OnExplainMachineStateClicked"
                                        Content="Refresh insight"
                                        FontSize="12"
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        IsEnabled="False" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="StoragePage"
                    AutomationProperties.AutomationId="StoragePage"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Padding="12,0,12,16" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Storage" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Read-only volume and folder inspection" />
                        </StackPanel>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Volumes" />
                                <TextBlock
                                    x:Name="SystemStorageSummaryText"
                                    AutomationProperties.AutomationId="SystemStorageSummaryText"
                                    Text="Loading..."
                                    TextWrapping="Wrap" />
                                <ItemsControl
                                    x:Name="StorageVolumesList"
                                    AutomationProperties.AutomationId="StorageVolumesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:StorageVolumeDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Header}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind VolumeDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind CapacityDetails}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="StorageStatusText"
                                    AutomationProperties.AutomationId="StorageStatusText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Loading..." />
                                <Button
                                    x:Name="RefreshStorageButton"
                                    AutomationProperties.AutomationId="RefreshStorageButton"
                                    Click="OnRefreshStorageClicked"
                                    Content="Refresh storage"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Name="LargeFolderRootText"
                                    AutomationProperties.AutomationId="LargeFolderRootText"
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Largest folders on system volume" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Read-only inspection of top-level folders with a 30-second time budget." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="ScanLargeFoldersButton"
                                        AutomationProperties.AutomationId="ScanLargeFoldersButton"
                                        Click="OnScanLargeFoldersClicked"
                                        Content="Scan large folders"
                                        IsEnabled="False" />
                                    <Button
                                        x:Name="CancelLargeFolderScanButton"
                                        AutomationProperties.AutomationId="CancelLargeFolderScanButton"
                                        Click="OnCancelLargeFolderScanClicked"
                                        Content="Cancel"
                                        IsEnabled="False" />
                                    <ProgressRing
                                        x:Name="LargeFolderScanProgressRing"
                                        AutomationProperties.AutomationId="LargeFolderScanProgressRing"
                                        Height="20"
                                        IsActive="False"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Width="20" />
                                </StackPanel>
                                <ItemsControl
                                    x:Name="LargeFoldersList"
                                    AutomationProperties.AutomationId="LargeFoldersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:LargeFolderDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Path}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind Details}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="LargeFolderScanStatusText"
                                    AutomationProperties.AutomationId="LargeFolderScanStatusText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="No folder scan yet." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="SoftwarePage"
                    AutomationProperties.AutomationId="SoftwarePage"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Padding="12,0,12,16" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Software" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Searchable read-only registrations" />
                        </StackPanel>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Classic desktop" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Registrations reported by Windows. No usage or removal inference." />
                                <TextBox
                                    x:Name="SoftwareSearchBox"
                                    AutomationProperties.AutomationId="SoftwareSearchBox"
                                    PlaceholderText="Search by name or publisher"
                                    TextChanged="OnSoftwareSearchTextChanged" />
                                <TextBlock
                                    x:Name="SoftwareInventorySummaryText"
                                    AutomationProperties.AutomationId="SoftwareInventorySummaryText"
                                    Text="0 registrations found&#x0a;Showing 0"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="RefreshSoftwareButton"
                                    AutomationProperties.AutomationId="RefreshSoftwareButton"
                                    Click="OnRefreshSoftwareClicked"
                                    Content="Refresh classic software"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False" />
                                <ListView
                                    x:Name="InstalledSoftwareList"
                                    AutomationProperties.AutomationId="InstalledSoftwareList"
                                    MaxHeight="260"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:InstalledSoftwareDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind PublisherAndVersion}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind RegistrationDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind InstallLocationDetails}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="SoftwareInventoryStatusText"
                                    AutomationProperties.AutomationId="SoftwareInventoryStatusText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Loading..." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Packaged applications" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Current-user MSIX/AppX packages. Source and update status are not inferred." />
                                <TextBox
                                    x:Name="PackagedSoftwareSearchBox"
                                    AutomationProperties.AutomationId="PackagedSoftwareSearchBox"
                                    PlaceholderText="Search by name, publisher, or package family"
                                    TextChanged="OnPackagedSoftwareSearchTextChanged" />
                                <TextBlock
                                    x:Name="PackagedSoftwareInventorySummaryText"
                                    AutomationProperties.AutomationId="PackagedSoftwareInventorySummaryText"
                                    Text="0 packages found&#x0a;Showing 0"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="RefreshPackagedSoftwareButton"
                                    AutomationProperties.AutomationId="RefreshPackagedSoftwareButton"
                                    Click="OnRefreshPackagedSoftwareClicked"
                                    Content="Refresh packaged applications"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False" />
                                <ListView
                                    x:Name="PackagedSoftwareList"
                                    AutomationProperties.AutomationId="PackagedSoftwareList"
                                    MaxHeight="260"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:PackagedSoftwareDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind DisplayName}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind PublisherVersionArchitecture}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind PackageFamilyDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind PackageFlagsDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind InstalledLocationDetails}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="PackagedSoftwareInventoryStatusText"
                                    AutomationProperties.AutomationId="PackagedSoftwareInventoryStatusText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Loading..." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="StartupPage"
                    AutomationProperties.AutomationId="StartupPage"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Padding="12,0,12,16" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Startup" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Run keys and Startup folders only" />
                        </StackPanel>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Startup applications" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Read-only registrations. Enabled state and startup impact are not inferred." />
                                <TextBox
                                    x:Name="StartupSearchBox"
                                    AutomationProperties.AutomationId="StartupSearchBox"
                                    PlaceholderText="Search by name, command, or path"
                                    TextChanged="OnStartupSearchTextChanged" />
                                <TextBlock
                                    x:Name="StartupInventorySummaryText"
                                    AutomationProperties.AutomationId="StartupInventorySummaryText"
                                    Text="0 entries found&#x0a;Showing 0"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="RefreshStartupButton"
                                    AutomationProperties.AutomationId="RefreshStartupButton"
                                    Click="OnRefreshStartupClicked"
                                    Content="Refresh startup applications"
                                    HorizontalAlignment="Left"
                                    IsEnabled="False" />
                                <ListView
                                    x:Name="StartupApplicationsList"
                                    AutomationProperties.AutomationId="StartupApplicationsList"
                                    MaxHeight="430"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:StartupApplicationDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind CommandOrPathDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind SourceDetails}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="StartupInventoryStatusText"
                                    AutomationProperties.AutomationId="StartupInventoryStatusText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Loading..." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="RuntimePage"
                    AutomationProperties.AutomationId="RuntimePage"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Padding="12,0,12,16" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Runtime" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Local processes and Ollama status" />
                        </StackPanel>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Top processes" />
                                <ItemsControl
                                    x:Name="TopProcessesList"
                                    AutomationProperties.AutomationId="TopProcessesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ProcessDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind Details}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="ProcessStatusText"
                                    AutomationProperties.AutomationId="ProcessStatusText"
                                    Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Ollama" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="Service" />
                                    <TextBlock
                                        x:Name="OllamaServiceStatusText"
                                        AutomationProperties.AutomationId="OllamaServiceStatusText"
                                        Grid.Column="1"
                                        Text="Loading..."
                                        TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="Version" />
                                    <TextBlock
                                        x:Name="OllamaVersionText"
                                        AutomationProperties.AutomationId="OllamaVersionText"
                                        Grid.Column="1"
                                        Text="Loading..."
                                        TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Loaded models" />
                                <ItemsControl
                                    x:Name="OllamaRunningModelsList"
                                    AutomationProperties.AutomationId="OllamaRunningModelsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:OllamaModelDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind ModelDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind RuntimeDetails}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="OllamaLoadedModelsStatusText"
                                    AutomationProperties.AutomationId="OllamaLoadedModelsStatusText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Loading..." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
