<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Machine.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App"
    xmlns:features="using:Machine.App.Features"
    Title="Matasuri">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid
        x:Name="MainContent"
        Background="Transparent"
        KeyDown="OnMainContentKeyDown"
        Loaded="OnMainContentLoaded">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="ShellAtmosphereLayer"
            Grid.RowSpan="2"
            Background="{StaticResource MatasuriAtmosphereBrush}"
            IsHitTestVisible="False" />
        <Border
            x:Name="GeneratingAtmosphereLayer"
            Grid.RowSpan="2"
            Background="{StaticResource MatasuriStateAccentBrush}"
            IsHitTestVisible="False"
            Opacity="0" />

        <Grid
            x:Name="DashboardChrome"
            Grid.Row="0"
            Height="34"
            Margin="8,3,8,0"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="DashboardDragRegion"
                Background="Transparent"
                SizeChanged="OnDashboardDragRegionSizeChanged" />
            <Button
                x:Name="DashboardCloseButton"
                AutomationProperties.AutomationId="DashboardCloseButton"
                AutomationProperties.Name="Return Matasuri to ambient presence"
                Click="OnDashboardCloseClicked"
                Grid.Column="1"
                Style="{StaticResource DashboardCloseButtonStyle}"
                ToolTipService.ToolTip="Return to orb">
                <FontIcon FontSize="11" Glyph="&#xE72B;" />
            </Button>
        </Grid>

        <Grid
            x:Name="DetailsPanel"
            AutomationProperties.AutomationId="DetailsPanel"
            Grid.Row="1"
            Margin="6,2,6,4"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="154" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Background="{StaticResource MatasuriSurfaceBrush}"
                BorderBrush="{StaticResource MatasuriHairlineBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="8,0,0,8">
                <Grid Padding="8,8,8,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="8,2,4,10" Spacing="1">
                        <TextBlock
                            AutomationProperties.Name="Matasuri"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Matasuri" />
                        <TextBlock
                            FontSize="9"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="local machine intelligence" />
                    </StackPanel>
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource NavigationGroupStyle}" Text="NOW" />
                            <Button
                    x:Name="OverviewNavigationItem"
                    AutomationProperties.AutomationId="OverviewNavigationItem"
                    Content="Overview"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="overview" />
                            <TextBlock Style="{StaticResource NavigationGroupStyle}" Text="MEMORY" />
                            <Button
                    x:Name="HistoryNavigationItem"
                    AutomationProperties.AutomationId="HistoryNavigationItem"
                    Content="History"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="history" />
                            <Button
                    x:Name="LearningNavigationItem"
                    AutomationProperties.AutomationId="LearningNavigationItem"
                    Content="Learning"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="learning" />
                            <TextBlock Style="{StaticResource NavigationGroupStyle}" Text="OBSERVE" />
                            <Button
                    x:Name="HealthNavigationItem"
                    AutomationProperties.AutomationId="HealthNavigationItem"
                    Content="Health"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="health" />
                            <Button
                    x:Name="NetworkNavigationItem"
                    AutomationProperties.AutomationId="NetworkNavigationItem"
                    Content="Network"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="network" />
                            <Button
                    x:Name="HardwareNavigationItem"
                    AutomationProperties.AutomationId="HardwareNavigationItem"
                    Content="Hardware"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="hardware" />
                            <Button
                    x:Name="StorageNavigationItem"
                    AutomationProperties.AutomationId="StorageNavigationItem"
                    Content="Storage"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="storage" />
                            <TextBlock Style="{StaticResource NavigationGroupStyle}" Text="SYSTEM" />
                            <Button
                    x:Name="SoftwareNavigationItem"
                    AutomationProperties.AutomationId="SoftwareNavigationItem"
                    Content="Software"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="software" />
                            <Button
                    x:Name="StartupNavigationItem"
                    AutomationProperties.AutomationId="StartupNavigationItem"
                    Content="Startup"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="startup" />
                            <Button
                    x:Name="ServicesNavigationItem"
                    AutomationProperties.AutomationId="ServicesNavigationItem"
                    Content="Services"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="services" />
                            <Button
                    x:Name="TasksNavigationItem"
                    AutomationProperties.AutomationId="TasksNavigationItem"
                    Content="Tasks"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="tasks" />
                            <Button
                    x:Name="DevicesNavigationItem"
                    AutomationProperties.AutomationId="DevicesNavigationItem"
                    Content="Devices"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="devices" />
                            <Button
                    x:Name="RuntimeNavigationItem"
                    AutomationProperties.AutomationId="RuntimeNavigationItem"
                    Content="Runtime"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="runtime" />
                        </StackPanel>
                    </ScrollViewer>
                    <Button
                        AutomationProperties.Name="Return to ambient Matasuri"
                        Click="OnDashboardBackClicked"
                        Content="Back to orb"
                        Grid.Row="2"
                        Style="{StaticResource MatasuriNavigationButtonStyle}" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <features:OverviewView
                    x:Name="OverviewPage"
                    AutomationProperties.AutomationId="OverviewPage" />
                <features:HistoryView
                    x:Name="HistoryPage"
                    AutomationProperties.AutomationId="HistoryPage"
                    Visibility="Collapsed" />
                <features:LearningView
                    x:Name="LearningPage"
                    AutomationProperties.AutomationId="LearningPage"
                    Visibility="Collapsed" />
                <features:NetworkView
                    x:Name="NetworkPage"
                    AutomationProperties.AutomationId="NetworkPage"
                    Visibility="Collapsed" />
                <features:HardwareView
                    x:Name="HardwarePage"
                    AutomationProperties.AutomationId="HardwarePage"
                    Visibility="Collapsed" />
                <features:HealthView
                    x:Name="HealthPage"
                    AutomationProperties.AutomationId="HealthPage"
                    Visibility="Collapsed" />
                <features:StorageView
                    x:Name="StoragePage"
                    AutomationProperties.AutomationId="StoragePage"
                    Visibility="Collapsed" />
                <features:SoftwareView
                    x:Name="SoftwarePage"
                    AutomationProperties.AutomationId="SoftwarePage"
                    Visibility="Collapsed" />
                <features:StartupView
                    x:Name="StartupPage"
                    AutomationProperties.AutomationId="StartupPage"
                    Visibility="Collapsed" />
                <features:ServicesView
                    x:Name="ServicesPage"
                    AutomationProperties.AutomationId="ServicesPage"
                    Visibility="Collapsed" />
                <features:TasksView
                    x:Name="TasksPage"
                    AutomationProperties.AutomationId="TasksPage"
                    Visibility="Collapsed" />
                <features:DevicesView
                    x:Name="DevicesPage"
                    AutomationProperties.AutomationId="DevicesPage"
                    Visibility="Collapsed" />
                <features:RuntimeView
                    x:Name="RuntimePage"
                    AutomationProperties.AutomationId="RuntimePage"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
