                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="TaskEnabledFilter"
                                AutomationProperties.Name="Filter scheduled tasks by enabled state"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="OnTaskFilterChanged">
                                <ComboBoxItem Content="All" Tag="all" />
                                <ComboBoxItem Content="Enabled" Tag="enabled" />
                                <ComboBoxItem Content="Disabled" Tag="disabled" />
                            </ComboBox>
                            <ComboBox
                                x:Name="TaskStateFilter"
                                AutomationProperties.Name="Filter scheduled tasks by runtime state"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="OnTaskFilterChanged">
                                <ComboBoxItem Content="Any state" Tag="all" />
                                <ComboBoxItem Content="Ready" Tag="Ready" />
                                <ComboBoxItem Content="Running" Tag="Running" />
                                <ComboBoxItem Content="Queued" Tag="Queued" />
                                <ComboBoxItem Content="Disabled" Tag="Disabled" />
                            </ComboBox>
                            <ComboBox
                                x:Name="TaskResultFilter"
                                AutomationProperties.Name="Filter scheduled tasks by last result"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="OnTaskFilterChanged">
                                <ComboBoxItem Content="Any result" Tag="all" />
                                <ComboBoxItem Content="Failed last run" Tag="failed" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="TasksSummaryText" Style="{StaticResource SecondaryTextStyle}" Text="Loading scheduled tasks" />
                        <ListView
                            x:Name="TasksList"
                            AutomationProperties.AutomationId="TasksList"
                            MaxHeight="600"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ScheduledTaskDisplayItem">
                                    <StackPanel Margin="0,6" Spacing="2">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind State}" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Path}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ScheduleDetails}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind EvidenceDetails}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="TasksStatusText" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="DevicesPage"
                    AutomationProperties.AutomationId="DevicesPage"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Padding="16,4,16,20" Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Devices" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Windows-reported devices and associated drivers" />
                            </StackPanel>
                            <Button
                                x:Name="RefreshDevicesButton"
                                AutomationProperties.Name="Refresh devices"
                                Click="OnRefreshDevicesClicked"
                                Content="Refresh"
                                Grid.Column="1" />
                        </Grid>
                        <TextBox
                            x:Name="DeviceSearchBox"
                            AutomationProperties.Name="Search devices"
                            PlaceholderText="Search device, class, manufacturer, or driver"
                            TextChanged="OnDeviceFilterChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="DeviceClassFilter"
                                AutomationProperties.Name="Filter devices by class"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="OnDeviceFilterChanged" />
                            <ComboBox
                                x:Name="DeviceProblemFilter"
                                AutomationProperties.Name="Filter devices by Windows-reported problem state"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="OnDeviceFilterChanged">
                                <ComboBoxItem Content="All devices" Tag="all" />
                                <ComboBoxItem Content="Windows-reported problem" Tag="problem" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="DevicesSummaryText" Style="{StaticResource SecondaryTextStyle}" Text="Loading devices" />
                        <ListView
                            x:Name="DevicesList"
                            AutomationProperties.AutomationId="DevicesList"
                            MaxHeight="600"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:DeviceDisplayItem">
                                    <StackPanel Margin="0,6" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Identity}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind DriverDetails}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind StatusDetails}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="DevicesStatusText" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="RuntimePage"
                    AutomationProperties.AutomationId="RuntimePage"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Padding="12,0,12,16" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Runtime" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Local processes and Ollama status" />
                        </StackPanel>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Top processes" />
                                <ItemsControl
                                    x:Name="TopProcessesList"
                                    AutomationProperties.AutomationId="TopProcessesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ProcessDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind Details}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="ProcessStatusText"
                                    AutomationProperties.AutomationId="ProcessStatusText"
                                    Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Ollama" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="Service" />
                                    <TextBlock
                                        x:Name="OllamaServiceStatusText"
                                        AutomationProperties.AutomationId="OllamaServiceStatusText"
                                        Grid.Column="1"
                                        Text="Loading..."
                                        TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="Version" />
                                    <TextBlock
                                        x:Name="OllamaVersionText"
                                        AutomationProperties.AutomationId="OllamaVersionText"
                                        Grid.Column="1"
                                        Text="Loading..."
                                        TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Loaded models" />
                                <ItemsControl
                                    x:Name="OllamaRunningModelsList"
                                    AutomationProperties.AutomationId="OllamaRunningModelsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:OllamaModelDisplayItem">
                                            <StackPanel Margin="0,4" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind ModelDetails}" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind RuntimeDetails}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="OllamaLoadedModelsStatusText"
                                    AutomationProperties.AutomationId="OllamaLoadedModelsStatusText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Loading..." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
