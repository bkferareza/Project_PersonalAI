<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Machine.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App"
    Title="Matasuri">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid
        x:Name="MainContent"
        Background="Transparent"
        KeyDown="OnMainContentKeyDown"
        Loaded="OnMainContentLoaded">
        <Grid.Resources>
            <SolidColorBrush x:Key="MatasuriAtmosphereBrush" Color="#263D5260" />
            <SolidColorBrush x:Key="MatasuriStateAccentBrush" Color="#FF718A84" />
            <SolidColorBrush x:Key="MatasuriSurfaceBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="MatasuriElevatedSurfaceBrush" Color="#2AFFFFFF" />
            <SolidColorBrush x:Key="MatasuriHairlineBrush" Color="#22FFFFFF" />
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter
                    Property="Background"
                    Value="{StaticResource MatasuriSurfaceBrush}" />
                <Setter
                    Property="BorderBrush"
                    Value="{StaticResource MatasuriHairlineBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,14" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="DashboardCloseButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="32" />
            </Style>
            <Style x:Key="MatasuriNavigationButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="10,5" />
            </Style>
            <Style x:Key="NavigationGroupStyle" TargetType="TextBlock">
                <Setter Property="CharacterSpacing" Value="140" />
                <Setter Property="FontSize" Value="9" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="Margin" Value="10,13,0,4" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="ShellAtmosphereLayer"
            Grid.RowSpan="2"
            Background="{StaticResource MatasuriAtmosphereBrush}"
            IsHitTestVisible="False" />
        <Border
            x:Name="GeneratingAtmosphereLayer"
            Grid.RowSpan="2"
            Background="{StaticResource MatasuriStateAccentBrush}"
            IsHitTestVisible="False"
            Opacity="0" />

        <Grid
            x:Name="DashboardChrome"
            Grid.Row="0"
            Height="34"
            Margin="8,3,8,0"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="DashboardDragRegion"
                Background="Transparent"
                SizeChanged="OnDashboardDragRegionSizeChanged" />
            <Button
                x:Name="DashboardCloseButton"
                AutomationProperties.AutomationId="DashboardCloseButton"
                AutomationProperties.Name="Close Matasuri"
                Click="OnDashboardCloseClicked"
                Grid.Column="1"
                Style="{StaticResource DashboardCloseButtonStyle}"
                ToolTipService.ToolTip="Close Matasuri">
                <FontIcon FontSize="11" Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <Grid
            x:Name="DetailsPanel"
            AutomationProperties.AutomationId="DetailsPanel"
            Grid.Row="1"
            Margin="6,2,6,4"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="154" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Background="{StaticResource MatasuriSurfaceBrush}"
                BorderBrush="{StaticResource MatasuriHairlineBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="8,0,0,8">
                <Grid Padding="8,8,8,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="8,2,4,10" Spacing="1">
                        <TextBlock
                            AutomationProperties.Name="Matasuri"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Matasuri" />
                        <TextBlock
                            FontSize="9"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="local machine intelligence" />
                    </StackPanel>
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource NavigationGroupStyle}" Text="NOW" />
                            <Button
                    x:Name="OverviewNavigationItem"
                    AutomationProperties.AutomationId="OverviewNavigationItem"
                    Content="Overview"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="overview" />
                            <TextBlock Style="{StaticResource NavigationGroupStyle}" Text="MEMORY" />
                            <Button
                    x:Name="HistoryNavigationItem"
                    AutomationProperties.AutomationId="HistoryNavigationItem"
                    Content="History"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="history" />
                            <Button
                    x:Name="LearningNavigationItem"
                    AutomationProperties.AutomationId="LearningNavigationItem"
                    Content="Learning"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="learning" />
                            <TextBlock Style="{StaticResource NavigationGroupStyle}" Text="OBSERVE" />
                            <Button
                    x:Name="HealthNavigationItem"
                    AutomationProperties.AutomationId="HealthNavigationItem"
                    Content="Health"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="health" />
                            <Button
                    x:Name="NetworkNavigationItem"
                    AutomationProperties.AutomationId="NetworkNavigationItem"
                    Content="Network"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="network" />
                            <Button
                    x:Name="HardwareNavigationItem"
                    AutomationProperties.AutomationId="HardwareNavigationItem"
                    Content="Hardware"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="hardware" />
                            <Button
                    x:Name="StorageNavigationItem"
                    AutomationProperties.AutomationId="StorageNavigationItem"
                    Content="Storage"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="storage" />
                            <TextBlock Style="{StaticResource NavigationGroupStyle}" Text="SYSTEM" />
                            <Button
                    x:Name="SoftwareNavigationItem"
                    AutomationProperties.AutomationId="SoftwareNavigationItem"
                    Content="Software"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="software" />
                            <Button
                    x:Name="StartupNavigationItem"
                    AutomationProperties.AutomationId="StartupNavigationItem"
                    Content="Startup"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="startup" />
                            <Button
                    x:Name="ServicesNavigationItem"
                    AutomationProperties.AutomationId="ServicesNavigationItem"
                    Content="Services"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="services" />
                            <Button
                    x:Name="TasksNavigationItem"
                    AutomationProperties.AutomationId="TasksNavigationItem"
                    Content="Tasks"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="tasks" />
                            <Button
                    x:Name="DevicesNavigationItem"
                    AutomationProperties.AutomationId="DevicesNavigationItem"
                    Content="Devices"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="devices" />
                            <Button
                    x:Name="RuntimeNavigationItem"
                    AutomationProperties.AutomationId="RuntimeNavigationItem"
                    Content="Runtime"
                    Click="OnDashboardNavigationClicked"
                    Style="{StaticResource MatasuriNavigationButtonStyle}"
                    Tag="runtime" />
                        </StackPanel>
                    </ScrollViewer>
                    <Button
                        AutomationProperties.Name="Return to ambient Matasuri"
                        Click="OnDashboardBackClicked"
                        Content="Back to orb"
                        Grid.Row="2"
                        Style="{StaticResource MatasuriNavigationButtonStyle}" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer
                    x:Name="OverviewPage"
                    AutomationProperties.AutomationId="OverviewPage"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="12,0,12,16" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="Overview" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="A grounded brief of what is happening now" />
                        </StackPanel>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="5">
                                <TextBlock
                                    Style="{StaticResource MetricLabelStyle}"
                                    Text="DETERMINISTIC STATE" />
                                <TextBlock
                                    x:Name="FindingsOverallStateText"
                                    AutomationProperties.AutomationId="FindingsOverallStateText"
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Text="Unknown" />
                                <TextBlock
                                    x:Name="OverviewStatePostureText"
                                    AutomationProperties.AutomationId="OverviewStatePostureText"
                                    FontSize="16"
                                    Text="Waiting for verified local evidence."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Style="{StaticResource MetricLabelStyle}"
                                    Text="LOCAL CONTEXT" />
                                <TextBlock
                                    x:Name="DeviceNameText"
                                    AutomationProperties.AutomationId="DeviceNameText"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Loading..."
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        x:Name="OperatingSystemText"
                                        AutomationProperties.AutomationId="OperatingSystemText"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Loading..." />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="&#x00B7;" />
                                    <TextBlock
                                        x:Name="ArchitectureText"
                                        AutomationProperties.AutomationId="ArchitectureText"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Loading..." />
                                </StackPanel>
                                <TextBlock
                                    x:Name="LoadStatusText"
                                    AutomationProperties.AutomationId="LoadStatusText"
                                    Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DashboardCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource MetricLabelStyle}"
                                        Text="CPU" />
                                    <TextBlock
                                        x:Name="CpuUsageText"
                                        AutomationProperties.AutomationId="CpuUsageText"
                                        FontSize="23"
                                        FontWeight="SemiBold"
                                        Text="Loading..."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Current usage" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="1"
                                Style="{StaticResource DashboardCardStyle}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource MetricLabelStyle}"
                                        Text="MEMORY" />
                                    <TextBlock
                                        x:Name="MemoryUsageText"
                                        AutomationProperties.AutomationId="MemoryUsageText"
                                        FontSize="19"
                                        FontWeight="SemiBold"
                                        Text="Loading..."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Used / total" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="5">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Network" />
                                <TextBlock
                                    x:Name="OverviewNetworkActivityText"
                                    AutomationProperties.AutomationId="OverviewNetworkActivityText"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="Unavailable" />
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="OverviewNetworkReceiveText"
                                        Text="Unavailable"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="OverviewNetworkSendText"
                                        Grid.Column="1"
                                        Text="Unavailable"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock
                                    x:Name="OverviewNetworkInterfaceText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Interface status unavailable" />
                                <TextBlock
                                    x:Name="OverviewSessionUptimeText"
                                    Margin="0,3,0,0"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Session uptime unavailable" />
                                <TextBlock
                                    x:Name="OverviewSessionActivityText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Input state unavailable" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            x:Name="TelemetryStatusText"
                            AutomationProperties.AutomationId="TelemetryStatusText"
                            Style="{StaticResource SecondaryTextStyle}"
                            Visibility="Collapsed" />
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="5">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Health" />
                                <TextBlock
                                    x:Name="OverviewHealthPrimaryText"
                                    AutomationProperties.AutomationId="OverviewHealthPrimaryText"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="Loading restart status"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="OverviewHealthSecondaryText"
                                    AutomationProperties.AutomationId="OverviewHealthSecondaryText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Loading reliability history" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="5">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Learning" />
                                <TextBlock
                                    x:Name="LearningConfidenceText"
                                    AutomationProperties.AutomationId="LearningConfidenceText"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="Calibrating" />
                                <TextBlock
                                    x:Name="LearningObservedDurationText"
                                    AutomationProperties.AutomationId="LearningObservedDurationText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="0m observed" />
                                <TextBlock
                                    x:Name="LearningObservationText"
                                    AutomationProperties.AutomationId="LearningObservationText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="0 samples" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="See Learning page for details." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="Current findings" />
                                <TextBlock
                                    x:Name="FindingsSummaryText"
                                    AutomationProperties.AutomationId="FindingsSummaryText"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Resource telemetry and readable system-volume data are unavailable." />
                                <ItemsControl
                                    x:Name="CurrentFindingsList"
                                    AutomationProperties.AutomationId="CurrentFindingsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:MachineFindingDisplayItem">
                                            <StackPanel Margin="0,3" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Header}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryTextStyle}"
                                                    Text="{x:Bind Detail}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="9">
                                <Grid>
                                    <TextBlock
                                        Style="{StaticResource SectionTitleStyle}"
                                        Text="Local insight" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Right"
                                        Text="Event-driven" />
                                </Grid>
                                <TextBlock
                                    x:Name="MachineExplanationText"
                                    AutomationProperties.AutomationId="MachineExplanationText"
                                    FontSize="16"
                                    LineHeight="23"
                                    Text="Watching for a meaningful change."
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="MachineExplanationStatusText"
                                    AutomationProperties.AutomationId="MachineExplanationStatusText"
                                    Style="{StaticResource SecondaryTextStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="MachineExplanationMetadataText"
                                        AutomationProperties.AutomationId="MachineExplanationMetadataText"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed" />
                                    <ProgressRing
                                        x:Name="MachineExplanationProgressRing"
                                        AutomationProperties.AutomationId="MachineExplanationProgressRing"
                                        Grid.Column="1"
                                        Height="18"
                                        IsActive="False"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Width="18" />
                                    <Button
                                        x:Name="ExplainMachineStateButton"
                                        AutomationProperties.AutomationId="ExplainMachineStateButton"
                                        Click="OnExplainMachineStateClicked"
                                        Content="Refresh insight"
                                        FontSize="12"
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        IsEnabled="False" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="HistoryPage"
                    AutomationProperties.AutomationId="HistoryPage"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Padding="16,4,16,20" Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Style="{StaticResource PageTitleStyle}"
                                    Text="History" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="What happened, while Matasuri was observing" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    x:Name="History24HourButton"
                                    AutomationProperties.Name="Show last 24 hours"
                                    Click="OnHistoryRangeClicked"
                                    Content="24h"
                                    Tag="24h" />
                                <Button
                                    x:Name="History7DayButton"
                                    AutomationProperties.Name="Show last 7 days"
                                    Click="OnHistoryRangeClicked"
                                    Content="7d"
                                    Tag="7d" />
                                <Button
                                    x:Name="History30DayButton"
                                    AutomationProperties.Name="Show last 30 days"
                                    Click="OnHistoryRangeClicked"
                                    Content="30d"
                                    Tag="30d" />
                                <Button
                                    x:Name="HistoryAllButton"
                                    AutomationProperties.Name="Show all retained history"
                                    Click="OnHistoryRangeClicked"
                                    Content="All"
                                    Tag="all" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Style="{StaticResource MetricLabelStyle}"
                                Text="OBSERVED" />
                            <TextBlock
                                x:Name="HistoryObservedDurationText"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="Beginning now" />
                            <TextBlock
                                x:Name="HistoryResolutionText"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="5-minute rollups · offline time remains a gap" />
                        </StackPanel>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource SectionTitleStyle}"
                                        Text="Resource posture" />
                                    <TextBlock
                                        x:Name="HistoryResourceSummaryText"
                                        Grid.Column="1"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="Waiting for history" />
                                </Grid>
                                <Canvas
                                    x:Name="HistoryTrendCanvas"
                                    Height="112"
                                    SizeChanged="OnHistoryTrendSizeChanged">
                                    <Path
                                        x:Name="HistoryCpuPolyline"
                                        Stroke="{StaticResource MatasuriStateAccentBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.5" />
                                    <Path
                                        x:Name="HistoryMemoryPolyline"
                                        Opacity="0.5"
                                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.2" />
                                    <Path
                                        x:Name="HistoryGpuPolyline"
                                        Opacity="0.7"
                                        Stroke="#FF9B8562"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1.2"
                                        Visibility="Collapsed" />
                                </Canvas>
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Text="CPU" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Memory" />
                                    <TextBlock
                                        x:Name="HistoryGpuLegendText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="GPU when available"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource SectionTitleStyle}"
                                Text="Observed time" />
                            <Grid Height="8" CornerRadius="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="HistoryActiveColumn" Width="1*" />
                                    <ColumnDefinition x:Name="HistoryIdleColumn" Width="0*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#806E8D87" CornerRadius="4,0,0,4" />
                                <Border Grid.Column="1" Background="#60717A86" CornerRadius="0,4,4,0" />
                            </Grid>
                            <TextBlock
                                x:Name="HistoryActivityText"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Active and Idle evidence will appear here" />
                            <Grid Height="6" CornerRadius="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="HistoryStableColumn" Width="1*" />
                                    <ColumnDefinition x:Name="HistoryAttentionColumn" Width="0*" />
                                    <ColumnDefinition x:Name="HistoryWarningColumn" Width="0*" />
                                    <ColumnDefinition x:Name="HistoryCriticalColumn" Width="0*" />
                                    <ColumnDefinition x:Name="HistoryUnknownColumn" Width="0*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#80718A84" CornerRadius="3,0,0,3" />
                                <Border Grid.Column="1" Background="#809B8562" />
                                <Border Grid.Column="2" Background="#80B37652" />
                                <Border Grid.Column="3" Background="#80A45346" />
                                <Border Grid.Column="4" Background="#806F7780" CornerRadius="0,3,3,0" />
                            </Grid>
                            <TextBlock
                                x:Name="HistoryStateDurationText"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="State-duration evidence will appear here" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock
                                Style="{StaticResource SectionTitleStyle}"
                                Text="Timeline" />
                            <ListView
                                x:Name="HistoryEventsList"
                                AutomationProperties.AutomationId="HistoryEventsList"
                                IsItemClickEnabled="False"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:HistoryEventDisplayItem">
                                        <Grid Margin="0,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
