<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Machine.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Machine.App"
    Title="Machine">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid
        x:Name="MainContent"
        Background="Transparent"
        GotFocus="OnMainContentGotFocus"
        Loaded="OnMainContentLoaded"
        LostFocus="OnMainContentLostFocus"
        Margin="12,6">
        <Grid.Resources>
            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter
                    Property="Background"
                    Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter
                    Property="BorderBrush"
                    Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14" />
            </Style>
            <Style x:Key="CompactMetricChipStyle" TargetType="Border">
                <Setter
                    Property="Background"
                    Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter
                    Property="BorderBrush"
                    Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="7,3" />
            </Style>
            <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter
                    Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            x:Name="CompactShell"
            AutomationProperties.AutomationId="CompactShell"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Grid.Row="0"
            Opacity="0.82"
            Padding="12,8"
            PointerEntered="OnCompactShellPointerEntered"
            PointerExited="OnCompactShellPointerExited">
            <Grid RowSpacing="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        CharacterSpacing="120"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="MACHINE"
                        VerticalAlignment="Center" />
                    <Border
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Grid.Column="1"
                        Padding="8,2">
                        <TextBlock
                            x:Name="OllamaPresenceStatusText"
                            AutomationProperties.AutomationId="OllamaPresenceStatusText"
                            FontSize="11"
                            MaxWidth="190"
                            Text="Status loading..."
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Ellipse
                        x:Name="PresenceIndicator"
                        AutomationProperties.AccessibilityView="Raw"
                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                        Height="9"
                        VerticalAlignment="Center"
                        Width="9" />
                    <TextBlock
                        x:Name="PresenceStateText"
                        AutomationProperties.AutomationId="PresenceStateText"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Status unavailable" />
                </StackPanel>
                <TextBlock
                    x:Name="PresenceTelemetryText"
                    AutomationProperties.AutomationId="PresenceTelemetryText"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Grid.Row="2"
                    Text="CPU unavailable &#x00B7; Memory unavailable"
                    TextTrimming="CharacterEllipsis" />
                <Grid Grid.Row="3" Margin="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="122" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CompactMetricChipStyle}">
                        <StackPanel Spacing="1">
                            <TextBlock
                                Style="{StaticResource MetricLabelStyle}"
                                Text="CPU" />
                            <TextBlock
                                x:Name="CompactCpuUsageText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="--" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource CompactMetricChipStyle}">
                        <StackPanel Spacing="1">
                            <TextBlock
                                Style="{StaticResource MetricLabelStyle}"
                                Text="MEMORY" />
                            <TextBlock
                                x:Name="CompactMemoryUsageText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="--" />
                        </StackPanel>
                    </Border>
                    <Button
                        x:Name="DetailsToggleButton"
                        AutomationProperties.AutomationId="DetailsToggleButton"
                        Click="OnDetailsToggleClicked"
                        Content="View dashboard"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Margin="8,0,0,0"
                        MinHeight="32"
                        Padding="8,2"
                        VerticalAlignment="Stretch" />
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="DetailsPanel"
            AutomationProperties.AutomationId="DetailsPanel"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            Margin="0,12,0,0"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <StackPanel Padding="0,0,0,16" Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="Dashboard" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Verified local machine overview" />
                </StackPanel>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{StaticResource MetricLabelStyle}"
                            Text="THIS MACHINE" />
                        <TextBlock
                            x:Name="DeviceNameText"
                            AutomationProperties.AutomationId="DeviceNameText"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="Loading..."
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                x:Name="OperatingSystemText"
                                AutomationProperties.AutomationId="OperatingSystemText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Loading..."
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="&#x00B7;" />
                            <TextBlock
                                x:Name="ArchitectureText"
                                AutomationProperties.AutomationId="ArchitectureText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Loading..."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            x:Name="LoadStatusText"
                            AutomationProperties.AutomationId="LoadStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource DashboardCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource MetricLabelStyle}"
                                Text="CPU" />
                            <TextBlock
                                x:Name="CpuUsageText"
                                AutomationProperties.AutomationId="CpuUsageText"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="Loading..."
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Current usage" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource DashboardCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource MetricLabelStyle}"
                                Text="MEMORY" />
                            <TextBlock
                                x:Name="MemoryUsageText"
                                AutomationProperties.AutomationId="MemoryUsageText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="Loading..."
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Used / total" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock
                    x:Name="TelemetryStatusText"
                    AutomationProperties.AutomationId="TelemetryStatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Current findings" />
                            <Border
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                HorizontalAlignment="Right"
                                Padding="8,2">
                                <TextBlock
                                    x:Name="FindingsOverallStateText"
                                    AutomationProperties.AutomationId="FindingsOverallStateText"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="Unknown"
                                    TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                        <TextBlock
                            x:Name="FindingsSummaryText"
                            AutomationProperties.AutomationId="FindingsSummaryText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Resource telemetry and readable system-volume data are unavailable."
                            TextWrapping="Wrap" />
                        <ItemsControl
                            x:Name="CurrentFindingsList"
                            AutomationProperties.AutomationId="CurrentFindingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:MachineFindingDisplayItem">
                                    <StackPanel Margin="0,4,0,4" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Header}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Detail}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Machine insight" />
                            <Border
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                HorizontalAlignment="Right"
                                Padding="8,2">
                                <TextBlock
                                    x:Name="MachineExplanationStateBadgeText"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="Unknown" />
                            </Border>
                        </Grid>
                        <TextBlock
                            x:Name="MachineExplanationText"
                            AutomationProperties.AutomationId="MachineExplanationText"
                            FontSize="16"
                            LineHeight="23"
                            Text="No explanation yet."
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="MachineExplanationStatusText"
                            AutomationProperties.AutomationId="MachineExplanationStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="MachineExplanationMetadataText"
                                AutomationProperties.AutomationId="MachineExplanationMetadataText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                            <ProgressRing
                                x:Name="MachineExplanationProgressRing"
                                AutomationProperties.AutomationId="MachineExplanationProgressRing"
                                Grid.Column="1"
                                Height="20"
                                IsActive="False"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Width="20" />
                            <Button
                                x:Name="ExplainMachineStateButton"
                                AutomationProperties.AutomationId="ExplainMachineStateButton"
                                Click="OnExplainMachineStateClicked"
                                Content="Generate insight"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                IsEnabled="False" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,4,0,0"
                    Text="Diagnostics" />
                <TextBlock
                    FontWeight="SemiBold"
                    Text="Top processes" />
                <ItemsControl
                    x:Name="TopProcessesList"
                    AutomationProperties.AutomationId="TopProcessesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ProcessDisplayItem">
                            <StackPanel Margin="0,4,0,4" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind Details}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="ProcessStatusText"
                    AutomationProperties.AutomationId="ProcessStatusText"
                    Margin="0,8,0,0"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontWeight="SemiBold"
                    Margin="0,16,0,0"
                    Text="Ollama" />
                <TextBlock
                    FontWeight="SemiBold"
                    Text="Service" />
                <TextBlock
                    x:Name="OllamaServiceStatusText"
                    AutomationProperties.AutomationId="OllamaServiceStatusText"
                    Margin="0,0,0,8"
                    Text="Loading..."
                    TextWrapping="Wrap" />
                <TextBlock
                    FontWeight="SemiBold"
                    Text="Version" />
                <TextBlock
                    x:Name="OllamaVersionText"
                    AutomationProperties.AutomationId="OllamaVersionText"
                    Margin="0,0,0,8"
                    Text="Loading..."
                    TextWrapping="Wrap" />
                <TextBlock
                    FontWeight="SemiBold"
                    Text="Loaded models" />
                <ItemsControl
                    x:Name="OllamaRunningModelsList"
                    AutomationProperties.AutomationId="OllamaRunningModelsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:OllamaModelDisplayItem">
                            <StackPanel Margin="0,4,0,4" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind ModelDetails}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind RuntimeDetails}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="OllamaLoadedModelsStatusText"
                    AutomationProperties.AutomationId="OllamaLoadedModelsStatusText"
                    Margin="0,8,0,0"
                    Text="Loading..."
                    TextWrapping="Wrap" />
                <TextBlock
                    FontWeight="SemiBold"
                    Margin="0,16,0,0"
                    Text="Storage" />
                <TextBlock
                    FontWeight="SemiBold"
                    Text="System volume" />
                <TextBlock
                    x:Name="SystemStorageSummaryText"
                    AutomationProperties.AutomationId="SystemStorageSummaryText"
                    Margin="0,0,0,8"
                    Text="Loading..."
                    TextWrapping="Wrap" />
                <TextBlock
                    FontWeight="SemiBold"
                    Text="All volumes" />
                <ItemsControl
                    x:Name="StorageVolumesList"
                    AutomationProperties.AutomationId="StorageVolumesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:StorageVolumeDisplayItem">
                            <StackPanel Margin="0,4,0,4" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Header}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind VolumeDetails}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind CapacityDetails}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="StorageStatusText"
                    AutomationProperties.AutomationId="StorageStatusText"
                    Margin="0,8,0,0"
                    Text="Loading..."
                    TextWrapping="Wrap" />
                <Button
                    x:Name="RefreshStorageButton"
                    AutomationProperties.AutomationId="RefreshStorageButton"
                    Click="OnRefreshStorageClicked"
                    Content="Refresh storage"
                    HorizontalAlignment="Left"
                    IsEnabled="False" />
                <TextBlock
                    x:Name="LargeFolderRootText"
                    AutomationProperties.AutomationId="LargeFolderRootText"
                    FontWeight="SemiBold"
                    Margin="0,16,0,0"
                    Text="Largest folders on system volume"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="Scan the system volume to measure its largest top-level folders."
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="The scan is read-only and stops after 30 seconds."
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="ScanLargeFoldersButton"
                        AutomationProperties.AutomationId="ScanLargeFoldersButton"
                        Click="OnScanLargeFoldersClicked"
                        Content="Scan large folders"
                        IsEnabled="False" />
                    <Button
                        x:Name="CancelLargeFolderScanButton"
                        AutomationProperties.AutomationId="CancelLargeFolderScanButton"
                        Click="OnCancelLargeFolderScanClicked"
                        Content="Cancel"
                        IsEnabled="False" />
                    <ProgressRing
                        x:Name="LargeFolderScanProgressRing"
                        AutomationProperties.AutomationId="LargeFolderScanProgressRing"
                        Height="20"
                        IsActive="False"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Width="20" />
                </StackPanel>
                <ItemsControl
                    x:Name="LargeFoldersList"
                    AutomationProperties.AutomationId="LargeFoldersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:LargeFolderDisplayItem">
                            <StackPanel Margin="0,4,0,4" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Path}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind Details}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="LargeFolderScanStatusText"
                    AutomationProperties.AutomationId="LargeFolderScanStatusText"
                    Margin="0,8,0,0"
                    Text="No folder scan yet."
                    TextWrapping="Wrap" />
                <TextBlock
                    FontWeight="SemiBold"
                    Margin="0,16,0,0"
                    Text="Installed software"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="Classic desktop registrations from Windows."
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="MSIX/AppX packages are listed separately below."
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="SoftwareSearchBox"
                    AutomationProperties.AutomationId="SoftwareSearchBox"
                    PlaceholderText="Search by name or publisher"
                    TextChanged="OnSoftwareSearchTextChanged" />
                <TextBlock
                    x:Name="SoftwareInventorySummaryText"
                    AutomationProperties.AutomationId="SoftwareInventorySummaryText"
                    Text="0 registrations found&#x0a;Showing 0"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="RefreshSoftwareButton"
                    AutomationProperties.AutomationId="RefreshSoftwareButton"
                    Click="OnRefreshSoftwareClicked"
                    Content="Refresh software"
                    HorizontalAlignment="Left"
                    IsEnabled="False" />
                <ListView
                    x:Name="InstalledSoftwareList"
                    AutomationProperties.AutomationId="InstalledSoftwareList"
                    MaxHeight="360"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:InstalledSoftwareDisplayItem">
                            <StackPanel Margin="0,4,0,4" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind PublisherAndVersion}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind RegistrationDetails}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind InstallLocationDetails}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="SoftwareInventoryStatusText"
                    AutomationProperties.AutomationId="SoftwareInventoryStatusText"
                    Margin="0,8,0,0"
                    Text="Loading..."
                    TextWrapping="Wrap" />
                <TextBlock
                    FontWeight="SemiBold"
                    Margin="0,16,0,0"
                    Text="Packaged applications"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="MSIX/AppX packages registered for the current user."
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="Installation source and update status are not inferred."
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="PackagedSoftwareSearchBox"
                    AutomationProperties.AutomationId="PackagedSoftwareSearchBox"
                    PlaceholderText="Search by name, publisher, or package family"
                    TextChanged="OnPackagedSoftwareSearchTextChanged" />
                <TextBlock
                    x:Name="PackagedSoftwareInventorySummaryText"
                    AutomationProperties.AutomationId="PackagedSoftwareInventorySummaryText"
                    Text="0 packages found&#x0a;Showing 0"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="RefreshPackagedSoftwareButton"
                    AutomationProperties.AutomationId="RefreshPackagedSoftwareButton"
                    Click="OnRefreshPackagedSoftwareClicked"
                    Content="Refresh packaged applications"
                    HorizontalAlignment="Left"
                    IsEnabled="False" />
                <ListView
                    x:Name="PackagedSoftwareList"
                    AutomationProperties.AutomationId="PackagedSoftwareList"
                    MaxHeight="360"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PackagedSoftwareDisplayItem">
                            <StackPanel Margin="0,4,0,4" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind DisplayName}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind PublisherVersionArchitecture}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind PackageFamilyDetails}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind PackageFlagsDetails}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind InstalledLocationDetails}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="PackagedSoftwareInventoryStatusText"
                    AutomationProperties.AutomationId="PackagedSoftwareInventoryStatusText"
                    Margin="0,8,0,0"
                    Text="Loading..."
                    TextWrapping="Wrap" />
                <TextBlock
                    FontWeight="SemiBold"
                    Margin="0,16,0,0"
                    Text="Startup applications"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="Read-only entries from Run registry keys and Startup folders."
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="Enabled state and startup impact are not reported."
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="StartupSearchBox"
                    AutomationProperties.AutomationId="StartupSearchBox"
                    PlaceholderText="Search by name, command, or path"
                    TextChanged="OnStartupSearchTextChanged" />
                <TextBlock
                    x:Name="StartupInventorySummaryText"
                    AutomationProperties.AutomationId="StartupInventorySummaryText"
                    Text="0 entries found&#x0a;Showing 0"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="RefreshStartupButton"
                    AutomationProperties.AutomationId="RefreshStartupButton"
                    Click="OnRefreshStartupClicked"
                    Content="Refresh startup applications"
                    HorizontalAlignment="Left"
                    IsEnabled="False" />
                <ListView
                    x:Name="StartupApplicationsList"
                    AutomationProperties.AutomationId="StartupApplicationsList"
                    MaxHeight="360"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:StartupApplicationDisplayItem">
                            <StackPanel Margin="0,4,0,4" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind CommandOrPathDetails}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind SourceDetails}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="StartupInventoryStatusText"
                    AutomationProperties.AutomationId="StartupInventoryStatusText"
                    Margin="0,8,0,0"
